# Local development defaults for `docker compose up`, not real secrets.
# The values below are what ships as the fallback in docker-compose.yml
# (${VAR:-default} syntax) purely so `make docker-up` works with zero
# setup. Copy this file to `.env` in this same directory and change the
# values if you want a non-default local Postgres user/password.
#
# A real deployment would never hold credentials in a committed file at
# all; it would inject them at deploy time from a secrets manager
# (Vault, AWS Secrets Manager, SSM Parameter Store, etc), never as a
# plaintext default baked into the compose file. That's out of scope
# for a local dev/take-home setup, this .env layer exists so the
# credentials are at least overridable rather than hardcoded-only.

POSTGRES_USER=oolio
POSTGRES_PASSWORD=oolio
POSTGRES_DB=oolio
API_KEY=apitest
