# Local development defaults for `docker compose up`, not real secrets.
# The Postgres values below are the fallbacks in docker-compose.yml
# (${VAR:-default} syntax) so `make docker-up` works with zero setup; app
# settings come from config/<APP_ENV>.json. Copy this file to `.env` in this same directory and change the
# values if you want a non-default local Postgres user/password.
#
# A real deployment would never hold credentials in a committed file at
# all; it would inject them at deploy time from a secrets manager
# (Vault, AWS Secrets Manager, SSM Parameter Store, etc), never as a
# plaintext default baked into the compose file. For now conisdering this for
# assessment purpose

POSTGRES_USER=oolio
POSTGRES_PASSWORD=oolio
POSTGRES_DB=oolio

# Which config/<APP_ENV>.json the server loads: dev, stage or prod.
APP_ENV=dev

# Overrides for the config file. Empty means "use the file's value", so dev
# needs none of them (config/dev.json has apitest, demo / demo1234, 15m).
# stage and prod need API_KEY, JWT_SECRET, AUTH_USERNAME and AUTH_PASSWORD
# here (DATABASE_URL is set by docker-compose.yml) and never fall back to
# in-memory storage. JWT_SECRET must be at least 32 bytes, e.g. from
# `openssl rand -base64 32`; empty in dev means a random one per boot.
LOG_LEVEL=
API_KEY=
JWT_SECRET=
JWT_TTL=
AUTH_USERNAME=
AUTH_PASSWORD=

# Grafana Cloud (compose profile "cloud"). From your stack: Connections →
# Hosted Prometheus metrics. The token needs the metrics:write scope. Keep
# real values only in deploy/.env (gitignored), never in this file.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_TOKEN=
