{
	"info": {
		"_postman_id": "6dd0237a-e263-404e-b0a2-8a56a97a7af9",
		"name": "Oolio Kart Challenge",
		"description": "Food-ordering API from the Oolio advanced backend challenge. Import alongside the `local` environment and run `make docker-up` first.\n\nCovers every documented endpoint plus the error paths called out in the README (401/403/422), plus the JWT flow (Auth folder: get a token, then order with it), so the collection doubles as a runnable reference for the API's behavior.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Products",
			"item": [
				{
					"name": "List Products",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/product",
							"host": ["{{baseUrl}}"],
							"path": ["product"]
						},
						"description": "No authentication required."
					}
				},
				{
					"name": "Get Product by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('id matches request', () => pm.expect(pm.response.json().id).to.eql('1'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/product/:id",
							"host": ["{{baseUrl}}"],
							"path": ["product", ":id"],
							"variable": [{"key": "id", "value": "1"}]
						}
					}
				},
				{
					"name": "Get Product by ID - Not Found",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 404', () => pm.response.to.have.status(404));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/product/:id",
							"host": ["{{baseUrl}}"],
							"path": ["product", ":id"],
							"variable": [{"key": "id", "value": "999"}]
						},
						"description": "productId 999 does not exist in the seeded catalog."
					}
				},
				{
					"name": "Get Product by ID - Invalid ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 400', () => pm.response.to.have.status(400));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/product/:id",
							"host": ["{{baseUrl}}"],
							"path": ["product", ":id"],
							"variable": [{"key": "id", "value": "abc"}]
						},
						"description": "productId must parse as an integer."
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Get Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('token type is Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
									"pm.test('token is a JWT', () => pm.expect(body.accessToken.split('.')).to.have.lengthOf(3));",
									"pm.test('expiresIn is positive', () => pm.expect(body.expiresIn).to.be.above(0));",
									"pm.collectionVariables.set('accessToken', body.accessToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "token"]
						},
						"description": "Exchanges the demo user's credentials for a JWT and saves it as {{accessToken}} for the requests below."
					}
				},
				{
					"name": "Get Token - Wrong Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 401', () => pm.response.to.have.status(401));",
									"pm.test('message does not say which field was wrong', () => pm.expect(pm.response.json().message).to.eql('invalid username or password'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "token"]
						},
						"description": "Unknown user and wrong password return the same 401, so usernames can't be probed."
					}
				},
				{
					"name": "Place Order - Bearer Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('order has an id', () => pm.expect(pm.response.json().id).to.be.a('string').and.not.empty);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{accessToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"2\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "Same endpoint as the api_key requests, authenticated with the JWT from Get Token instead."
					}
				},
				{
					"name": "Place Order - Tampered Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 401', () => pm.response.to.have.status(401));",
									"pm.test('WWW-Authenticate names the error', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('invalid_token'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{accessToken}}tampered"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"2\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "A token whose signature no longer matches is rejected with 401."
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Place Order - Valid Coupon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('discount was applied', () => pm.expect(body.discounts).to.be.above(0));",
									"pm.test('total = subtotal - discounts', () => pm.expect(body.total).to.eql(Math.round((body.subtotal - body.discounts) * 100) / 100));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 1 },\n    { \"productId\": \"9\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"HAPPYHRS\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "HAPPYHRS is one of the 8 codes that actually survive the coupon-index build; a flat 5% discount applies."
					}
				},
				{
					"name": "Place Order - No Coupon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('no discount applied', () => pm.expect(pm.response.json().discounts).to.eql(0));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 2 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						}
					}
				},
				{
					"name": "Place Order - Duplicate Product IDs",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('duplicate line items are merged', () => pm.expect(pm.response.json().items).to.have.lengthOf(1));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 1 },\n    { \"productId\": \"1\", \"quantity\": 2 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "Regression case for a real bug: the same productId sent twice is merged into one line item with a summed quantity, instead of hitting the order_items composite key."
					}
				},
				{
					"name": "Place Order - Missing API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 401', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						}
					}
				},
				{
					"name": "Place Order - Wrong API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 403', () => pm.response.to.have.status(403));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "wrong-key"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						}
					}
				},
				{
					"name": "Place Order - Empty Items",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 422', () => pm.response.to.have.status(422));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": []\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						}
					}
				},
				{
					"name": "Place Order - Unknown Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 422', () => pm.response.to.have.status(422));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"999\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						}
					}
				},
				{
					"name": "Place Order - Quantity Above Maximum",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 422', () => pm.response.to.have.status(422));",
									"pm.test('message names the limit', () => pm.expect(pm.response.json().message).to.include('at most 1000'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"10\", \"quantity\": 20000000 }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "Regression case for a real bug: this quantity overflowed Postgres NUMERIC(10,2) and returned 500. Quantities above 1000 per line item are now a 422."
					}
				},
				{
					"name": "Place Order - Too Many Items",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const items = Array.from({ length: 101 }, () => ({ productId: '1', quantity: 1 }));",
									"pm.variables.set('tooManyItemsBody', JSON.stringify({ items }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 422', () => pm.response.to.have.status(422));",
									"pm.test('message names the limit', () => pm.expect(pm.response.json().message).to.include('at most 100 items'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{{tooManyItemsBody}}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "101 lines (the pre-request script builds them). An order can have at most 100 lines, checked before any per-line work, so a huge cart costs one comparison."
					}
				},
				{
					"name": "Place Order - Invalid Coupon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 422', () => pm.response.to.have.status(422));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "api_key", "value": "{{apiKey}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"1\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"BADCODE1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order",
							"host": ["{{baseUrl}}"],
							"path": ["order"]
						},
						"description": "BADCODE1 is well-formed (8-10 chars) but does not appear in 2 of the 3 coupon source files."
					}
				}
			]
		},
