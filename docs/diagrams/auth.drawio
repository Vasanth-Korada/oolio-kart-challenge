<mxfile host="app.diagrams.net"><diagram name="HLD - JWT auth" id="ah"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ah1" value="&lt;b&gt;Authentication: High-Level Design&lt;/b&gt;  ·  POST /auth/token + Bearer JWT on POST /order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="ah2" value="Authentication (who is calling?) and authorization (may they place orders?) are separate middleware. Handlers depend on auth interfaces, never on golang-jwt directly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1450" height="24" as="geometry"/></mxCell><mxCell id="ah3" value="CLIENTS" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="210" height="790" as="geometry"/></mxCell><mxCell id="ah4" value="&lt;b&gt;curl / any HTTP client&lt;/b&gt;&lt;br&gt;① POST /auth/token&lt;br&gt;② Authorization: Bearer &amp;lt;jwt&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="80" as="geometry"/></mxCell><mxCell id="ah5" value="&lt;b&gt;Postman / newman&lt;/b&gt;&lt;br&gt;Auth folder: token, Bearer order, tampered token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="ah6" value="&lt;b&gt;React web app&lt;/b&gt;&lt;br&gt;api_key header&lt;br&gt;(base spec, unchanged)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="ah7" value="cmd/server · newAuth(cfg) wires one JWTManager as both issuer and verifier" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="960" height="790" as="geometry"/></mxCell><mxCell id="ah8" value="TRANSPORT · internal/httpapi" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="920" height="320" as="geometry"/></mxCell><mxCell id="ah9" value="&lt;b&gt;http.ServeMux&lt;/b&gt;&lt;br&gt;① POST /auth/token → AuthHandler&lt;br&gt;② POST /order → Authenticate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ RequireScope → OrderHandler&lt;br&gt;GET routes stay public" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="260" height="110" as="geometry"/></mxCell><mxCell id="ah10" value="&lt;b&gt;Authenticate&lt;/b&gt; (who?)&lt;br&gt;Bearer token → TokenVerifier.Verify&lt;br&gt;else api_key → ConstantTimeCompare&lt;br&gt;none or bad token → 401 · wrong key → 403&lt;br&gt;claims → request context" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="270" height="110" as="geometry"/></mxCell><mxCell id="ah11" value='&lt;b&gt;RequireScope("create_order")&lt;/b&gt; (may they?)&lt;br&gt;ClaimsFromContext → HasScope&lt;br&gt;missing scope → 403&lt;br&gt;WWW-Authenticate: insufficient_scope' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="250" height="110" as="geometry"/></mxCell><mxCell id="ah12" value="&lt;b&gt;AuthHandler.Token&lt;/b&gt;&lt;br&gt;body ≤ 1 KiB, bad JSON → 400&lt;br&gt;UserStore.Authenticate → 401&lt;br&gt;TokenIssuer.Issue → 200 JSON&lt;br&gt;Cache-Control: no-store" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="260" height="110" as="geometry"/></mxCell><mxCell id="ah13" value="&lt;b&gt;OrderHandler.Create&lt;/b&gt;&lt;br&gt;unchanged (see order diagrams)&lt;br&gt;caller's claims available via&lt;br&gt;ClaimsFromContext" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="320" width="250" height="110" as="geometry"/></mxCell><mxCell id="ah14" value="&lt;b&gt;AuthMetrics&lt;/b&gt;&lt;br&gt;AuthAttempt(method, ok)&lt;br&gt;→ oolio_auth_attempts_total&lt;br&gt;method: password · bearer · api_key&lt;br&gt;result: success · failure" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="200" height="110" as="geometry"/></mxCell><mxCell id="ah15" value="DOMAIN · internal/auth" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="920" height="240" as="geometry"/></mxCell><mxCell id="ah16" value="&lt;b&gt;MemoryUserStore&lt;/b&gt; · UserStore&lt;br&gt;bcrypt DefaultCost (≈60 ms)&lt;br&gt;unknown user → compared against a dummy hash, so timing matches a wrong password&lt;br&gt;→ ErrInvalidCredentials" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="515" width="260" height="170" as="geometry"/></mxCell><mxCell id="ah17" value="&lt;b&gt;JWTManager&lt;/b&gt; · TokenIssuer + TokenVerifier&lt;br&gt;github.com/golang-jwt/jwt/v5 · HS256&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; iss, sub, aud, iat, exp, jti, scope&lt;br&gt;&lt;b&gt;Verify:&lt;/b&gt; HS256 only · signature · iss · aud · exp required · iat · 30 s leeway&lt;br&gt;→ Claims or ErrInvalidToken" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="515" width="270" height="170" as="geometry"/></mxCell><mxCell id="ah18" value='&lt;b&gt;auth.go&lt;/b&gt; (interfaces first)&lt;br&gt;&lt;br&gt;TokenIssuer.Issue(sub, scopes)&lt;br&gt;TokenVerifier.Verify(token)&lt;br&gt;UserStore.Authenticate(ctx, user, pw)&lt;br&gt;Claims{Subject, Scopes, ExpiresAt}&lt;br&gt;ScopeCreateOrder = "create_order"' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="515" width="250" height="170" as="geometry"/></mxCell><mxCell id="ah19" value="CONFIG · internal/config (env)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="730" width="920" height="130" as="geometry"/></mxCell><mxCell id="ah20" value="&lt;b&gt;JWT_SECRET&lt;/b&gt;: HS256 key, ≥ 32 bytes&lt;br&gt;unset → RandomSecret() + warn log (tokens die on restart)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="770" width="280" height="70" as="geometry"/></mxCell><mxCell id="ah21" value="&lt;b&gt;JWT_TTL&lt;/b&gt;: 15m&lt;br&gt;invalid → config.Load error, server exits" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="270" height="70" as="geometry"/></mxCell><mxCell id="ah22" value="&lt;b&gt;AUTH_USERNAME / AUTH_PASSWORD&lt;/b&gt;&lt;br&gt;demo / demo1234, bcrypt-hashed at boot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="770" width="270" height="70" as="geometry"/></mxCell><mxCell id="ah23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah4" target="ah9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="190"/><mxPoint x="250" y="225"/></Array></mxGeometry></mxCell><mxCell id="ah24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah5" target="ah9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="300"/><mxPoint x="250" y="225"/></Array></mxGeometry></mxCell><mxCell id="ah25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah6" target="ah9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="405"/><mxPoint x="250" y="225"/></Array></mxGeometry></mxCell><mxCell id="ah26" value="② POST /order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah9" target="ah10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah27" value="claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah10" target="ah11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah28" value="scope ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ah11" target="ah13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah29" value="① POST /auth/token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ah9" target="ah12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah30" value="Authenticate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ah12" target="ah16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah31" value="Issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="ah12" target="ah17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="460"/><mxPoint x="640" y="460"/></Array></mxGeometry></mxCell><mxCell id="ah32" value="Verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="ah10" target="ah17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ah33" value="KEY POINTS" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1230" y="90" width="350" height="790" as="geometry"/></mxCell><mxCell id="ah34" value="&lt;b&gt;Design choices&lt;/b&gt;&lt;br&gt;• Authn and authz are separate middleware: each is tested alone&lt;br&gt;• api_key kept for base-spec clients; it maps to the create_order scope&lt;br&gt;• Bearer is checked first; a bad token is 401 even with a good api_key (no silent fallback)&lt;br&gt;• Algorithm pinned: alg none, HS512 and forged signatures all fail the same way&lt;br&gt;• Same 401 text and same bcrypt cost for unknown user and wrong password&lt;br&gt;• Stateless: no session table; any replica with the secret can verify" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="310" height="280" as="geometry"/></mxCell><mxCell id="ah35" value='&lt;b&gt;Token (JWS compact)&lt;/b&gt;&lt;br&gt;base64url(header) . base64url(payload) . signature&lt;br&gt;&lt;br&gt;{"alg":"HS256","typ":"JWT"}&lt;br&gt;{"scope":"create_order","iss":"oolio-kart",&lt;br&gt;&amp;nbsp;"sub":"demo","aud":["oolio-kart-api"],&lt;br&gt;&amp;nbsp;"exp":…,"iat":…,"jti":"&amp;lt;uuid&amp;gt;"}&lt;br&gt;HMAC-SHA256(header.payload, JWT_SECRET)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="430" width="310" height="190" as="geometry"/></mxCell><mxCell id="ah36" value="&lt;b&gt;Out of scope (known limitations)&lt;/b&gt;&lt;br&gt;• One demo user from env, no users table&lt;br&gt;• No refresh tokens or revocation (jti is ready for a denylist)&lt;br&gt;• No login rate limit&lt;br&gt;• HS256 shared secret; RS256 + JWKS when other services verify" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1250" y="640" width="310" height="170" as="geometry"/></mxCell><mxCell id="ah37" value="&lt;b&gt;Status codes&lt;/b&gt;:  POST /auth/token → 200 token  ·  400 bad JSON or body &amp;gt; 1 KiB  ·  401 wrong credentials  ·  500 signing failed  ||  POST /order → 401 no credentials or bad/expired token  ·  403 wrong api_key or missing create_order scope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1550" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - token issue and verify" id="al"><mxGraphModel dx="1760" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="al1" value="&lt;b&gt;Authentication: Low-Level Design&lt;/b&gt;  ·  every branch of POST /auth/token and of the POST /order auth middleware" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="al2" value="Main path runs top to bottom; red boxes are early exits with the exact status and message the client sees (all bodies use the {code, type, message} envelope)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1500" height="24" as="geometry"/></mxCell><mxCell id="al3" value="POST /auth/token · auth_handler.go" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="540" height="860" as="geometry"/></mxCell><mxCell id="al4" value="&lt;b&gt;AuthHandler.Token&lt;/b&gt;&lt;br&gt;http.MaxBytesReader(body, 1 KiB)&lt;br&gt;json.Decode(&amp;amp;tokenRequest{username, password})" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="al5" value="decode ok ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="al6" value="&lt;b&gt;400&lt;/b&gt; invalid_body&lt;br&gt;“request body must be valid JSON” (also body &amp;gt; 1 KiB)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="240" width="185" height="60" as="geometry"/></mxCell><mxCell id="al7" value='&lt;b&gt;UserStore.Authenticate&lt;/b&gt;&lt;br&gt;hash = users[name].hash,&lt;br&gt;or dummyHash if unknown&lt;br&gt;bcrypt.CompareHashAndPassword&lt;br&gt;AuthAttempt("password", ok)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="300" height="110" as="geometry"/></mxCell><mxCell id="al8" value="user known and&lt;br&gt;password matches ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="260" height="80" as="geometry"/></mxCell><mxCell id="al9" value="&lt;b&gt;401&lt;/b&gt; unauthorized&lt;br&gt;“invalid username or password” (same for unknown user)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="490" width="185" height="60" as="geometry"/></mxCell><mxCell id="al10" value='&lt;b&gt;TokenIssuer.Issue&lt;/b&gt;(sub, scopes) · JWTManager&lt;br&gt;iss oolio-kart · aud oolio-kart-api&lt;br&gt;sub demo · scope "create_order"&lt;br&gt;iat now · exp now + JWT_TTL · jti UUID v4&lt;br&gt;SigningMethodHS256.SignedString(secret)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="110" as="geometry"/></mxCell><mxCell id="al11" value="signed ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="260" height="70" as="geometry"/></mxCell><mxCell id="al12" value="&lt;b&gt;500&lt;/b&gt; internal&lt;br&gt;“failed to issue token” (error logged)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="735" width="185" height="60" as="geometry"/></mxCell><mxCell id="al13" value='&lt;b&gt;200&lt;/b&gt; · Cache-Control: no-store&lt;br&gt;{accessToken, tokenType: "Bearer",&lt;br&gt;&amp;nbsp;expiresIn: 900}' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="300" height="80" as="geometry"/></mxCell><mxCell id="al14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al4" target="al5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al5" target="al6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al5" target="al7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al7" target="al8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al8" target="al9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al8" target="al10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al10" target="al11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al11" target="al12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al11" target="al13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al23" value="POST /order · Authenticate → RequireScope (middleware.go) · runs inside RequestID, Metrics, Recover, Logging, CORS" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="1160" height="860" as="geometry"/></mxCell><mxCell id="al24" value="Authorization&lt;br&gt;header set ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="280" height="80" as="geometry"/></mxCell><mxCell id="al25" value="scheme “Bearer” (any case)&lt;br&gt;and token ≠ “” ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="280" height="90" as="geometry"/></mxCell><mxCell id="al26" value="&lt;b&gt;TokenVerifier.Verify(token)&lt;/b&gt; · golang-jwt&lt;br&gt;WithValidMethods([HS256]) · signature&lt;br&gt;WithIssuer · WithAudience&lt;br&gt;WithExpirationRequired · WithIssuedAt&lt;br&gt;WithLeeway(30 s) · sub ≠ “”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="280" height="105" as="geometry"/></mxCell><mxCell id="al27" value="token valid ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="505" width="280" height="75" as="geometry"/></mxCell><mxCell id="al28" value='&lt;b&gt;401&lt;/b&gt; unauthorized&lt;br&gt;“invalid or expired token”&lt;br&gt;WWW-Authenticate: Bearer error="invalid_token"&lt;br&gt;AuthAttempt(bearer, false)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="370" width="230" height="90" as="geometry"/></mxCell><mxCell id="al29" value="AuthAttempt(bearer, true)&lt;br&gt;ctx = withClaims(claims)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="610" width="280" height="55" as="geometry"/></mxCell><mxCell id="al30" value="api_key&lt;br&gt;header set ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="130" width="280" height="80" as="geometry"/></mxCell><mxCell id="al31" value="&lt;b&gt;401&lt;/b&gt; unauthorized&lt;br&gt;“missing credentials: send an Authorization Bearer token or the api_key header”&lt;br&gt;WWW-Authenticate: Bearer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="120" width="225" height="100" as="geometry"/></mxCell><mxCell id="al32" value="subtle.ConstantTimeCompare&lt;br&gt;(key, API_KEY) == 1 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="250" width="280" height="90" as="geometry"/></mxCell><mxCell id="al33" value="&lt;b&gt;403&lt;/b&gt; forbidden&lt;br&gt;“invalid api_key”&lt;br&gt;AuthAttempt(api_key, false)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="265" width="225" height="60" as="geometry"/></mxCell><mxCell id="al34" value='AuthAttempt(api_key, true)&lt;br&gt;claims = {sub: "api_key", scopes: [create_order]}&lt;br&gt;ctx = withClaims(claims)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="370" width="280" height="70" as="geometry"/></mxCell><mxCell id="al35" value="&lt;b&gt;RequireScope&lt;/b&gt;&lt;br&gt;claims.HasScope(“create_order”) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="715" width="280" height="90" as="geometry"/></mxCell><mxCell id="al36" value='&lt;b&gt;403&lt;/b&gt; forbidden&lt;br&gt;“token lacks the create_order scope”&lt;br&gt;WWW-Authenticate: Bearer error="insufficient_scope", scope="create_order"' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="720" width="300" height="80" as="geometry"/></mxCell><mxCell id="al37" value="&lt;b&gt;OrderHandler.Create&lt;/b&gt;&lt;br&gt;(order LLD: decode → service → 200)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="280" height="60" as="geometry"/></mxCell><mxCell id="al38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al24" target="al25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al39" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al24" target="al30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al40" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al25" target="al26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al41" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="al25" target="al28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al26" target="al27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al43" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="al27" target="al28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al44" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al27" target="al29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al29" target="al35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al46" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al30" target="al31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al47" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al30" target="al32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al48" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al32" target="al33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al49" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al32" target="al34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="al34" target="al35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="690"/><mxPoint x="760" y="690"/></Array></mxGeometry></mxCell><mxCell id="al51" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al35" target="al36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al52" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al35" target="al37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="al53" value="&lt;b&gt;Bearer wins&lt;/b&gt;: once an Authorization header is present the api_key header is never read, so a bad token + a good key is still 401." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="370" width="225" height="110" as="geometry"/></mxCell><mxCell id="al54" value="&lt;b&gt;401 vs 403&lt;/b&gt;&lt;br&gt;401 = we don't know who you are (no credentials, bad or expired token): retry with credentials; always carries WWW-Authenticate: Bearer (RFC 6750).&lt;br&gt;403 = we know who you are, but no (wrong api_key kept from v1, or the token lacks create_order)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="420" height="125" as="geometry"/></mxCell><mxCell id="al55" value="&lt;b&gt;One error for every bad token&lt;/b&gt;&lt;br&gt;Expired, tampered payload, forged signature, alg none, HS512, wrong iss or aud, missing exp or sub, Basic scheme: all map to ErrInvalidToken → the same 401. The client learns nothing about which check failed." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="980" width="420" height="125" as="geometry"/></mxCell><mxCell id="al56" value="&lt;b&gt;Metrics&lt;/b&gt; · oolio_auth_attempts_total{method, result}&lt;br&gt;password: POST /auth/token · bearer: token verification · api_key: key check.&lt;br&gt;A valid token without the scope counts as bearer success (authentication passed); the 403 shows up in oolio_http_requests_total." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="900" y="980" width="420" height="125" as="geometry"/></mxCell><mxCell id="al57" value="&lt;b&gt;Timing&lt;/b&gt;&lt;br&gt;MemoryUserStore always runs one bcrypt compare, so unknown user and wrong password take the same ~60 ms (measured on the dry-run page)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1340" y="980" width="400" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Dry run - real requests" id="ad"><mxGraphModel dx="1620" dy="1355" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1355" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ad1" value="&lt;b&gt;Authentication: Dry Run&lt;/b&gt;  ·  captured from the real stack (docker compose: Go server + Postgres 16)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="ad2" value="Every status, header, claim, log line and timing below came from actual requests on 2026-09-24. Only the token signature and the jti are shortened." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ad3" value='&lt;b&gt;REQUEST ①&lt;/b&gt;&lt;br&gt;POST /auth/token HTTP/1.1&lt;br&gt;Content-Type: application/json&lt;br&gt;X-Request-Id: dryrun-auth-001&lt;br&gt;&lt;br&gt;{"username": "demo", "password": "demo1234"}' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="440" height="130" as="geometry"/></mxCell><mxCell id="ad4" value='&lt;b&gt;RESPONSE ①&lt;/b&gt;  200 OK&lt;br&gt;Cache-Control: no-store&lt;br&gt;Content-Type: application/json&lt;br&gt;X-Request-Id: dryrun-auth-001&lt;br&gt;&lt;br&gt;{"accessToken": "eyJhbGciOiJIUzI1NiIs…3S0",&lt;br&gt;&amp;nbsp;"tokenType": "Bearer", "expiresIn": 900}' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="480" height="130" as="geometry"/></mxCell><mxCell id="ad5" value="&lt;b&gt;1 · Decode&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad6" value='tokenRequest{Username: "demo", Password: "demo1234"} · body 41 bytes, under the 1 KiB cap' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="260" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ad3" target="ad5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ad8" value="&lt;b&gt;2 · UserStore&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="170" height="55" as="geometry"/></mxCell><mxCell id="ad9" value='users["demo"] found → bcrypt.CompareHashAndPassword ✓ → User{demo, [create_order]}&lt;br&gt;AuthAttempt("password", true)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="312" width="760" height="55" as="geometry"/></mxCell><mxCell id="ad10" value="&lt;b&gt;3 · Issue&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="379" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad11" value="HS256 over header + payload with JWT_SECRET → 295-character token (3 dot-separated parts)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="379" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad12" value="&lt;b&gt;4 · Response&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad13" value="200 in 99.6 ms (bcrypt cost 10 dominates) · Cache-Control: no-store so no proxy keeps the token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="431" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad14" value='&lt;b&gt;REQUEST ②&lt;/b&gt;&lt;br&gt;POST /order HTTP/1.1&lt;br&gt;Authorization: Bearer eyJhbGciOiJIUzI1NiIs…3S0&lt;br&gt;X-Request-Id: dryrun-auth-002&lt;br&gt;&lt;br&gt;{"items": [{"productId": "2", "quantity": 2}],&lt;br&gt;&amp;nbsp;"couponCode": "HAPPYHRS"}' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="501" width="440" height="145" as="geometry"/></mxCell><mxCell id="ad15" value='&lt;b&gt;RESPONSE ②&lt;/b&gt;  200 OK · X-Request-Id: dryrun-auth-002&lt;br&gt;&lt;br&gt;{"id": "c82390e1-1add-4d69-b2b1-ddc7c3e4ccbd",&lt;br&gt;&amp;nbsp;"items": [{"productId":"2","quantity":2}],&lt;br&gt;&amp;nbsp;"products": [{"id":"2", "name":"Vanilla Bean Crème Brûlée", …}],&lt;br&gt;&amp;nbsp;"couponCode": "HAPPYHRS",&lt;br&gt;&amp;nbsp;"subtotal": 14, "discounts": 0.7, "total": 13.3}' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="501" width="480" height="145" as="geometry"/></mxCell><mxCell id="ad16" value="&lt;b&gt;5 · ServeMux&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad17" value="“POST /order” matched → Authenticate → RequireScope → OrderHandler.Create" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="676" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ad14" target="ad16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ad19" value="&lt;b&gt;6 · Authenticate&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="170" height="55" as="geometry"/></mxCell><mxCell id="ad20" value="Authorization set → scheme “Bearer” ✓ → Verify: alg HS256 ✓ · signature ✓ · iss oolio-kart ✓&lt;br&gt;aud oolio-kart-api ✓ · exp 1790248330 &amp;gt; now ✓ · sub “demo” → claims in ctx · AuthAttempt(bearer, true)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="728" width="760" height="55" as="geometry"/></mxCell><mxCell id="ad21" value="&lt;b&gt;7 · RequireScope&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad22" value='claims.Scopes = [create_order] → HasScope("create_order") ✓' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="795" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad23" value="&lt;b&gt;8 · Order&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="847" width="170" height="40" as="geometry"/></mxCell><mxCell id="ad24" value="same path as the order dry run: 2 × 7.00 = 14.00, HAPPYHRS −0.70 → total 13.30 → 200 in 12.4 ms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="847" width="760" height="40" as="geometry"/></mxCell><mxCell id="ad25" value='&lt;b&gt;DECODED TOKEN&lt;/b&gt; (base64url, no secret needed to read it)&lt;br&gt;&lt;br&gt;&lt;b&gt;header&lt;/b&gt;&lt;br&gt;{"alg":"HS256","typ":"JWT"}&lt;br&gt;&lt;br&gt;&lt;b&gt;payload&lt;/b&gt;&lt;br&gt;{"scope":"create_order",&lt;br&gt;&amp;nbsp;"iss":"oolio-kart",&lt;br&gt;&amp;nbsp;"sub":"demo",&lt;br&gt;&amp;nbsp;"aud":["oolio-kart-api"],&lt;br&gt;&amp;nbsp;"exp":1790248330,&amp;nbsp;&amp;nbsp;← iat + 900 s&lt;br&gt;&amp;nbsp;"iat":1790247430,&lt;br&gt;&amp;nbsp;"jti":"63c7c575-…"}&lt;br&gt;&lt;br&gt;&lt;b&gt;signature&lt;/b&gt;&lt;br&gt;HMAC-SHA256(header.payload, JWT_SECRET)&lt;br&gt;anyone can read the claims; only the secret can make them verify' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="560" height="290" as="geometry"/></mxCell><mxCell id="ad26" value='&lt;b&gt;LOG LINES&lt;/b&gt; (JSON, stdout)&lt;br&gt;&lt;br&gt;{"level":"INFO","msg":"http request","request_id":"dryrun-auth-001",&lt;br&gt;&amp;nbsp;"method":"POST","path":"/auth/token","status":200,"duration_ms":99.576}&lt;br&gt;&lt;br&gt;{"level":"INFO","msg":"http request","request_id":"dryrun-auth-002",&lt;br&gt;&amp;nbsp;"method":"POST","path":"/order","status":200,"duration_ms":12.363}&lt;br&gt;&lt;br&gt;no token or password appears in any log line' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="560" height="150" as="geometry"/></mxCell><mxCell id="ad27" value="&lt;b&gt;TIMING&lt;/b&gt;: unknown user vs wrong password (3 each, access log duration_ms)&lt;br&gt;&lt;br&gt;wrong password (demo / nope)&amp;nbsp;&amp;nbsp;&amp;nbsp;73.7 · 60.7 · 62.1&lt;br&gt;unknown user (ghost / nope)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;62.2 · 64.1 · 59.1&lt;br&gt;&lt;br&gt;same bcrypt work either way → response time doesn't reveal which usernames exist" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="560" height="130" as="geometry"/></mxCell><mxCell id="ad28" value="&lt;b&gt;METRICS&lt;/b&gt; after this page's requests (GET /metrics)&lt;br&gt;&lt;br&gt;oolio_auth_attempts_total{method=&quot;password&quot;,result=&quot;success&quot;} 1&lt;br&gt;oolio_auth_attempts_total{method=&quot;password&quot;,result=&quot;failure&quot;} 2&lt;br&gt;oolio_auth_attempts_total{method=&quot;bearer&quot;,result=&quot;success&quot;} 2&lt;br&gt;oolio_auth_attempts_total{method=&quot;bearer&quot;,result=&quot;failure&quot;} 5&lt;br&gt;oolio_auth_attempts_total{method=&quot;api_key&quot;,result=&quot;success&quot;} 7&lt;br&gt;oolio_auth_attempts_total{method=&quot;api_key&quot;,result=&quot;failure&quot;} 1&lt;br&gt;&lt;br&gt;bearer success 2 = the order above + the no-scope token (authenticated, then 403)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="730" width="560" height="170" as="geometry"/></mxCell><mxCell id="ad29" value="&lt;b&gt;Error paths&lt;/b&gt;: same stack, one request each (actual status, WWW-Authenticate and message)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1200" height="24" as="geometry"/></mxCell><mxCell id="ad30" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px;font-family:Courier New'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;request&lt;/th&gt;&lt;th&gt;status&lt;/th&gt;&lt;th&gt;WWW-Authenticate&lt;/th&gt;&lt;th&gt;message&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /auth/token · wrong password&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;invalid username or password&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /auth/token · unknown user “ghost”&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;invalid username or password&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /auth/token · malformed JSON&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;400&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;request body must be valid JSON&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /auth/token · 2 KB body&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;400&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;request body must be valid JSON&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · no credentials&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer&lt;/td&gt;&lt;td&gt;missing credentials: send an Authorization Bearer token or the api_key header&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · Bearer, last signature char changed&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;invalid_token&quot;&lt;/td&gt;&lt;td&gt;invalid or expired token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · Bearer, exp 30 min ago&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;invalid_token&quot;&lt;/td&gt;&lt;td&gt;invalid or expired token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · Bearer, alg none (no signature)&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;invalid_token&quot;&lt;/td&gt;&lt;td&gt;invalid or expired token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · Authorization: Basic …&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;invalid_token&quot;&lt;/td&gt;&lt;td&gt;invalid or expired token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · Bearer nope + api_key: apitest&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;invalid_token&quot;&lt;/td&gt;&lt;td&gt;invalid or expired token (Bearer wins)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · valid token, scope &quot;read&quot;&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;403&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bearer error=&quot;insufficient_scope&quot;, scope=&quot;create_order&quot;&lt;/td&gt;&lt;td&gt;token lacks the create_order scope&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · api_key: nope&lt;/td&gt;&lt;td&gt;&lt;b style='color:#000000'&gt;403&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;invalid api_key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POST /order · api_key: apitest&lt;/td&gt;&lt;td&gt;&lt;b style='color:#2e7d32'&gt;200&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;order created (base spec path unchanged)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1540" height="375" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>