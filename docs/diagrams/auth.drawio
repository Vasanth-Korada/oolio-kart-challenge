<mxfile host="app.diagrams.net"><diagram name="HLD - JWT auth" id="ah"><mxGraphModel dx="1320" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ah1" value="&lt;b&gt;Authentication&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="ah2" value="Get a token once, then send it with every order. The api_key still works." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="ah3" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="150" height="64" as="geometry"/></mxCell><mxCell id="ah4" value="&lt;b&gt;POST /auth/token&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;username + password&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="ah5" value="&lt;b&gt;User store&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;bcrypt password check&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="ah6" value="&lt;b&gt;JWT manager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;signs HS256 tokens, 15 min&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="230" height="64" as="geometry"/></mxCell><mxCell id="ah7" value="① login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah3" target="ah4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ah4" target="ah5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah9" value="issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ah5" target="ah6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah10" value="&lt;b&gt;POST /order&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Bearer token or api_key&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="220" height="64" as="geometry"/></mxCell><mxCell id="ah11" value="&lt;b&gt;Authenticate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;who is calling?&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="210" height="64" as="geometry"/></mxCell><mxCell id="ah12" value="&lt;b&gt;Require scope&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;may they order?&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="230" height="64" as="geometry"/></mxCell><mxCell id="ah13" value="&lt;b&gt;Order handler&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="180" height="64" as="geometry"/></mxCell><mxCell id="ah14" value="② order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="ah3" target="ah10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ah10" target="ah11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ah11" target="ah12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ah12" target="ah13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah18" value="verify token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;dashed=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="ah11" target="ah6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ah19" value="&lt;b&gt;401 vs 403&lt;/b&gt;&lt;br&gt;• 401: we don't know who you are&lt;br&gt;• 403: we know you, but not allowed&lt;br&gt;• Every bad token gets the same 401" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="430" width="380" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - token issue and verify" id="al"><mxGraphModel dx="1120" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="al1" value="&lt;b&gt;Authentication: step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="al2" value="Left: getting a token. Right: checking it on POST /order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="al3" value="&lt;b&gt;POST /auth/token&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="210" height="60" as="geometry"/></mxCell><mxCell id="al4" value="Valid JSON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="205" width="220" height="84" as="geometry"/></mxCell><mxCell id="al5" value="400 bad JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="224" width="180" height="46" as="geometry"/></mxCell><mxCell id="al6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al4" target="al5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al3" target="al4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al8" value="Password correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="320" width="220" height="84" as="geometry"/></mxCell><mxCell id="al9" value="401 invalid login" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="339" width="180" height="46" as="geometry"/></mxCell><mxCell id="al10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al8" target="al9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al4" target="al8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al12" value="&lt;b&gt;Sign token&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HS256 · 15 minutes&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="435" width="210" height="60" as="geometry"/></mxCell><mxCell id="al13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al8" target="al12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al14" value="&lt;b&gt;200&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;token JSON&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="210" height="60" as="geometry"/></mxCell><mxCell id="al15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al12" target="al14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al16" value="&lt;b&gt;POST /order&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="210" height="60" as="geometry"/></mxCell><mxCell id="al17" value="Credentials sent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="635" y="205" width="220" height="84" as="geometry"/></mxCell><mxCell id="al18" value="401 missing" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="224" width="180" height="46" as="geometry"/></mxCell><mxCell id="al19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al17" target="al18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al16" target="al17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al21" value="Token or key valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="635" y="320" width="220" height="84" as="geometry"/></mxCell><mxCell id="al22" value="401 bad token&lt;br&gt;403 wrong key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="339" width="180" height="46" as="geometry"/></mxCell><mxCell id="al23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al21" target="al22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al17" target="al21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al25" value="Has create_order?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="635" y="435" width="220" height="84" as="geometry"/></mxCell><mxCell id="al26" value="403 not allowed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="454" width="180" height="46" as="geometry"/></mxCell><mxCell id="al27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="al25" target="al26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al21" target="al25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="al29" value="&lt;b&gt;Order handler&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="550" width="210" height="60" as="geometry"/></mxCell><mxCell id="al30" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="al25" target="al29"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Dry run - real requests" id="ad"><mxGraphModel dx="900" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ad1" value="&lt;b&gt;Authentication: dry run&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="ad2" value="Real requests on Docker + Postgres, with the values they produced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="ad3" value="&lt;b&gt;1 · Login&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;demo / demo1234 → 200 in 99.6 ms&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="360" height="60" as="geometry"/></mxCell><mxCell id="ad4" value="&lt;b&gt;2 · Token&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HS256, 295 characters, valid 15 min&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="360" height="60" as="geometry"/></mxCell><mxCell id="ad5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ad3" target="ad4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ad6" value="&lt;b&gt;3 · Order with token&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;signature, issuer, audience, expiry ✓&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="360" height="60" as="geometry"/></mxCell><mxCell id="ad7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ad4" target="ad6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ad8" value="&lt;b&gt;4 · Result&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;200 in 12.4 ms · total 13.30&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="360" height="60" as="geometry"/></mxCell><mxCell id="ad9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ad6" target="ad8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ad10" value="&lt;b&gt;Error responses&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding='5' style='font-size:13px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;wrong password or unknown user&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;400&lt;/b&gt;&lt;/td&gt;&lt;td&gt;login body is not valid JSON&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tampered or expired token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;no credentials&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;403&lt;/b&gt;&lt;/td&gt;&lt;td&gt;wrong api_key&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="400" height="230" as="geometry"/></mxCell><mxCell id="ad11" value="&lt;b&gt;Same timing on purpose&lt;/b&gt;&lt;br&gt;• Wrong password: ~62 ms&lt;br&gt;• Unknown user: ~62 ms&lt;br&gt;• So usernames can't be guessed" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="380" width="400" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>