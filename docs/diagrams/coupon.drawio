"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="cl2" value="Each file is processed in parallel, then the results are merged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="cl3" value="For each of the 3 files, in parallel" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="700" height="470" as="geometry"/></mxCell><mxCell id="cl4" value="&lt;b&gt;Read&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;gzip, one line at a time&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="230" height="64" as="geometry"/></mxCell><mxCell id="cl5" value="&lt;b&gt;Filter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;keep 8 to 10 characters&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="230" height="64" as="geometry"/></mxCell><mxCell id="cl6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="cl4" target="cl5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl7" value="&lt;b&gt;Encode&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;11-byte key: length + code&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="350" width="230" height="64" as="geometry"/></mxCell><mxCell id="cl8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="cl5" target="cl7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl9" value="&lt;b&gt;Sort + dedupe&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;one list per file&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="230" height="64" as="geometry"/></mxCell><mxCell id="cl10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="cl7" target="cl9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl11" value="&lt;b&gt;Merge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;keep codes in 2+ files&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="820" y="250" width="220" height="64" as="geometry"/></mxCell><mxCell id="cl12" value="&lt;b&gt;Write coupons.idx&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;header + sorted keys&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="220" height="64" as="geometry"/></mxCell><mxCell id="cl13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cl9" target="cl11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="cl11" target="cl12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl15" value="&lt;b&gt;Numbers&lt;/b&gt;&lt;br&gt;• 313M lines → 8 valid codes&lt;br&gt;• ~5 minutes, ~1.2 GB per file&lt;br&gt;• Lookup: length check + binary search" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="320" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - Dry run" id="cd"><mxGraphModel dx="1200" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cd1" value="&lt;b&gt;Coupon index build: dry run&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="cd2" value="13 lines in 3 small files, traced to the final index (bytes verified)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="cd3" value="&lt;b&gt;File 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HAPPYHRS · SHORT · BURGER10&lt;br&gt;FIFTYOFF · BURGER10 · ABCDEFGHIJK&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="330" height="76" as="geometry"/></mxCell><mxCell id="cd4" value="&lt;b&gt;File 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;FIFTYOFF · PIZZA2024&lt;br&gt;HAPPYHRS · TACOTUES&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="330" height="76" as="geometry"/></mxCell><mxCell id="cd5" value="&lt;b&gt;File 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HAPPYHRS · TACOTUES · SUPER100&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="330" height="76" as="geometry"/></mxCell><mxCell id="cd6" value="&lt;b&gt;How many files each code is in&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding='4' style='font-size:13px'&gt;&lt;tr&gt;&lt;td&gt;HAPPYHRS&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td style='color:#2e7d32'&gt;✓ valid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FIFTYOFF&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td style='color:#2e7d32'&gt;✓ valid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TACOTUES&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td style='color:#2e7d32'&gt;✓ valid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BURGER10&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td style='color:#b71c1c'&gt;✗ (twice, same file)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PIZZA2024 · SUPER100&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td style='color:#b71c1c'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SHORT · ABCDEFGHIJK&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td style='color:#b71c1c'&gt;✗ wrong length&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="400" height="250" as="geometry"/></mxCell><mxCell id="cd7" value="&lt;b&gt;coupons.idx&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;41 bytes = 8 header + 3 × 11&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="250" height="80" as="geometry"/></mxCell><mxCell id="cd8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="cd6" target="cd7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cd9" value="&lt;b&gt;Lookups&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding='4' style='font-size:13px'&gt;&lt;tr&gt;&lt;td&gt;TACOTUES&lt;/td&gt;&lt;td style='color:#2e7d32'&gt;valid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PIZZA2024&lt;/td&gt;&lt;td style='color:#b71c1c'&gt;invalid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SHORT&lt;/td&gt;&lt;td style='color:#b71c1c'&gt;rejected by length&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="250" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>