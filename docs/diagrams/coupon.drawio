<mxfile host="app.diagrams.net"><diagram name="HLD - Coupon validation" id="h"><mxGraphModel dx="1520" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="&lt;b&gt;Coupon Validation: High-Level Design&lt;/b&gt;  ·  submission-v2 (raw code keys)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="h2" value="Rule: a code is valid iff &lt;b&gt;8 to 10 chars&lt;/b&gt; AND it appears in &lt;b&gt;at least 2 of the 3&lt;/b&gt; source files. Heavy work happens once offline; each request does an in-memory O(log n) lookup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1400" height="24" as="geometry"/></mxCell><mxCell id="h3" value="1 · OFFLINE BUILD (one-time, developer or CI machine)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1480" height="250" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;AWS S3&lt;/b&gt;&lt;br&gt;orderfoodonline-files&lt;br&gt;couponbase1/2/3.gz" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="190" height="110" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b&gt;scripts/fetch_coupons.sh&lt;/b&gt;&lt;br&gt;&lt;i&gt;make fetch-coupons&lt;/i&gt;&lt;br&gt;curl -C - (resume)&lt;br&gt;verify size == Content-Length&lt;br&gt;up to 30 attempts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="145" width="230" height="120" as="geometry"/></mxCell><mxCell id="h6" value="&lt;b&gt;coupons/raw/*.gz&lt;/b&gt;&lt;br&gt;3 files · ~2.1 GB compressed&lt;br&gt;313,087,705 lines total&lt;br&gt;&lt;i&gt;gitignored&lt;/i&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="145" width="230" height="120" as="geometry"/></mxCell><mxCell id="h7" value="&lt;b&gt;cmd/buildindex&lt;/b&gt;&lt;br&gt;&lt;i&gt;make build-coupon-index&lt;/i&gt;&lt;br&gt;BuildIndex(paths) → Build([]Source)&lt;br&gt;Scan → filter → makeKey → sort&lt;br&gt;→ dedupe → k-way merge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="260" height="130" as="geometry"/></mxCell><mxCell id="h8" value="&lt;b&gt;Why offline?&lt;/b&gt;&lt;br&gt;• Source data is static&lt;br&gt;• 2.1 GB decompress per boot = waste&lt;br&gt;• Build pays O(N log N) once&lt;br&gt;• Runtime pays O(log n) per order&lt;br&gt;• See LLD page for internals" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1190" y="140" width="280" height="130" as="geometry"/></mxCell><mxCell id="h9" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h10" value="write .part → mv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h11" value="gzip stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h6" target="h7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h12" value="2 · SHIP (version-controlled artifact)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1480" height="150" as="geometry"/></mxCell><mxCell id="h13" value="&lt;b&gt;coupons/coupons.idx&lt;/b&gt;&lt;br&gt;96 B = 8 B header + 8 × 11 B keys&lt;br&gt;committed to git" style="shape=document;boundedLbl=1;size=0.2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="260" height="80" as="geometry"/></mxCell><mxCell id="h14" value="&lt;b&gt;deploy/Dockerfile&lt;/b&gt;&lt;br&gt;multi-stage: golang:1.25 → distroless&lt;br&gt;COPY coupons.idx ./coupons/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="400" width="280" height="80" as="geometry"/></mxCell><mxCell id="h15" value="&lt;b&gt;Why commit the index?&lt;/b&gt;&lt;br&gt;tiny, deterministic; image build never needs 2.1 GB.&lt;br&gt;⚠ v2 keys are plaintext codes: in prod, build in CI instead" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="320" height="100" as="geometry"/></mxCell><mxCell id="h16" value="writeIndex()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h7" target="h13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h17" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h13" target="h14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h18" value="3 · RUNTIME (cmd/server)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1480" height="380" as="geometry"/></mxCell><mxCell id="h19" value="&lt;b&gt;server startup&lt;/b&gt;&lt;br&gt;loadCouponValidator(&lt;br&gt;COUPON_INDEX_PATH)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="560" width="220" height="80" as="geometry"/></mxCell><mxCell id="h20" value="&lt;b&gt;LoadIndex()&lt;/b&gt; · format.go&lt;br&gt;magic == CPX2?&lt;br&gt;size == 8+11·n?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="190" height="100" as="geometry"/></mxCell><mxCell id="h21" value="&lt;b&gt;unavailableValidator&lt;/b&gt;&lt;br&gt;IsValid() → always false&lt;br&gt;&lt;i&gt;fail closed&lt;/i&gt; + warn log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="230" height="80" as="geometry"/></mxCell><mxCell id="h22" value="&lt;b&gt;server exits&lt;/b&gt;&lt;br&gt;fail fast at boot&lt;br&gt;(corrupt / truncated index)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="720" width="220" height="70" as="geometry"/></mxCell><mxCell id="h23" value="&lt;b&gt;coupon.Index&lt;/b&gt; (implements Validator)&lt;br&gt;index.go · keys []codeKey, sorted, in RAM&lt;br&gt;IsValid: len 8-10 → makeKey&lt;br&gt;→ sort.Search → equality" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="770" width="250" height="110" as="geometry"/></mxCell><mxCell id="h24" value="image runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h14" target="h19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="h19" target="h20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h26" value="file missing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="h20" target="h21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h27" value="bad magic / size" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h20" target="h22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h28" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h20" target="h23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h29" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;(React app / curl / Postman)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="150" height="70" as="geometry"/></mxCell><mxCell id="h30" value="&lt;b&gt;POST /order&lt;/b&gt;&lt;br&gt;RequestID · Recover · Logging · CORS&lt;br&gt;+ APIKeyAuth (route)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="785" width="200" height="80" as="geometry"/></mxCell><mxCell id="h31" value="&lt;b&gt;OrderHandler.Create&lt;/b&gt;&lt;br&gt;JSON → domain types&lt;br&gt;err → 400 / 422 / 500" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="785" width="180" height="80" as="geometry"/></mxCell><mxCell id="h32" value="&lt;b&gt;order.Service.PlaceOrder&lt;/b&gt;&lt;br&gt;coupons.IsValid(code)?&lt;br&gt;valid → 5% discount&lt;br&gt;invalid → ErrInvalidCoupon (422)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="775" width="230" height="100" as="geometry"/></mxCell><mxCell id="h33" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h29" target="h30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h30" target="h31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h31" target="h32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h36" value="Validator iface" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h32" target="h23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h37" value="(if index missing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="h32" target="h21"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Package map - interfaces" id="p"><mxGraphModel dx="1600" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1" value="&lt;b&gt;coupon package: files &amp;amp; interfaces&lt;/b&gt;  ·  submission-v2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p2" value="Three interfaces sit at the real seams: what the order flow needs (Validator), where codes come from (Source), and where the index goes (io.Writer). Everything else is plain functions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p3" value="CALLERS" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1560" height="110" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;cmd/buildindex&lt;/b&gt;&lt;br&gt;offline CLI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="240" height="60" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;cmd/server&lt;/b&gt;&lt;br&gt;loadCouponValidator()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="125" width="240" height="60" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;order.Service.PlaceOrder&lt;/b&gt;&lt;br&gt;coupons.IsValid(code)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="125" width="280" height="60" as="geometry"/></mxCell><mxCell id="p7" value="BUILD SIDE (offline)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="560" height="660" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;build.go&lt;/b&gt;&lt;hr&gt;BuildIndex(paths, out, logger) Stats&lt;br&gt;&amp;nbsp;&amp;nbsp;wraps each path in GzipFileSource&lt;br&gt;Build(sources []Source, out, logger) Stats&lt;br&gt;collectKeys · dedupeSorted&lt;br&gt;mergeAtLeastN · writeIndexFile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="520" height="150" as="geometry"/></mxCell><mxCell id="p9" value="«interface»&lt;br&gt;&lt;b&gt;Source&lt;/b&gt;  (source.go)&lt;hr&gt;Name() string&lt;br&gt;Scan(onCode func(string)) (lines int64, err error)&lt;br&gt;&lt;i&gt;ErrPartialRead: input ended early&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="520" height="110" as="geometry"/></mxCell><mxCell id="p10" value="&lt;b&gt;GzipFileSource&lt;/b&gt;&lt;hr&gt;Path string&lt;br&gt;gzip → bufio.Scanner&lt;br&gt;drops a cut-off last line" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="250" height="110" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;fakeSource&lt;/b&gt;  (build_test.go)&lt;hr&gt;lines []string · err error&lt;br&gt;in-memory test double" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="640" width="250" height="110" as="geometry"/></mxCell><mxCell id="p12" value="FILE FORMAT" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="420" height="660" as="geometry"/></mxCell><mxCell id="p13" value="&lt;b&gt;format.go&lt;/b&gt;&lt;hr&gt;CPX2 layout: magic · count · keys&lt;br&gt;writeIndex(w io.Writer, keys)&lt;br&gt;parseIndex(data) ([]codeKey, error)&lt;br&gt;LoadIndex(path) (*Index, error)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="380" height="150" as="geometry"/></mxCell><mxCell id="p14" value="«interface»&lt;br&gt;&lt;b&gt;io.Writer&lt;/b&gt;  (stdlib)&lt;hr&gt;Write(p []byte) (n int, err error)&lt;br&gt;&lt;i&gt;*os.File in production&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="380" height="90" as="geometry"/></mxCell><mxCell id="p15" value="&lt;b&gt;key.go&lt;/b&gt;&lt;hr&gt;codeKey [11]byte: len byte + code&lt;br&gt;makeKey(code) · compareKeys(a, b)&lt;br&gt;&lt;i&gt;shared by build, format, index&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="380" height="110" as="geometry"/></mxCell><mxCell id="p16" value="RUNTIME (per request)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="540" height="660" as="geometry"/></mxCell><mxCell id="p17" value="«interface»&lt;br&gt;&lt;b&gt;Validator&lt;/b&gt;  (validator.go)&lt;hr&gt;IsValid(code string) bool" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1060" y="260" width="500" height="80" as="geometry"/></mxCell><mxCell id="p18" value="&lt;b&gt;Index&lt;/b&gt;  (index.go)&lt;hr&gt;keys []codeKey (sorted)&lt;br&gt;IsValid: ValidLength → makeKey&lt;br&gt;&amp;nbsp;&amp;nbsp;→ sort.Search → ==&lt;br&gt;Len() int" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1060" y="420" width="260" height="130" as="geometry"/></mxCell><mxCell id="p19" value="&lt;b&gt;unavailableValidator&lt;/b&gt;&lt;hr&gt;IsValid → always false&lt;br&gt;&lt;i&gt;fail closed: cmd/server&lt;br&gt;uses it when the index&lt;br&gt;file is missing&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1340" y="420" width="220" height="130" as="geometry"/></mxCell><mxCell id="p20" value="&lt;b&gt;Why these three, and no more&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Validator&lt;/b&gt;: order.Service needs a lookup, not a file or a sorted slice; tests and the fail-closed fallback swap in freely.&lt;br&gt;• &lt;b&gt;Source&lt;/b&gt;: the build shouldn't care where codes come from; tests use fakeSource, future inputs (plain text, S3) plug in.&lt;br&gt;• &lt;b&gt;io.Writer&lt;/b&gt;: the stdlib seam for output.&lt;br&gt;• No interface for Build, Index or the format: one implementation each, so an interface would only add indirection." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="500" height="190" as="geometry"/></mxCell><mxCell id="p21" value="BuildIndex(paths, out, logger)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="1" source="p4" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p22" value="Scan(onCode) per source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="1" source="p8" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p23" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;" edge="1" parent="1" source="p10" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p24" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;" edge="1" parent="1" source="p11" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p25" value="writeIndexFile&lt;br&gt;→ writeIndex" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;exitX=1;exitY=0.85;entryX=0;entryY=0.85;" edge="1" parent="1" source="p8" target="p13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p26" value="writes via" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="1" source="p13" target="p14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p27" value="LoadIndex(path)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="1" source="p5" target="p13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p28" value="returns *Index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.2;" edge="1" parent="1" source="p13" target="p18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p29" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="1" source="p6" target="p17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p30" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;" edge="1" parent="1" source="p18" target="p17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p31" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;" edge="1" parent="1" source="p19" target="p17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p32" value="&lt;b&gt;Legend&lt;/b&gt;:  dashed line + hollow triangle = implements the interface  ·  solid line + open arrow = calls / uses  ·  «interface» boxes are white" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1500" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - BuildIndex internals" id="l"><mxGraphModel dx="1600" dy="1730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1730" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1" value="&lt;b&gt;BuildIndex: Low-Level Design&lt;/b&gt;  ·  internal/coupon  ·  submission-v2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="l2" value="build.go runs one goroutine per Source; results join at g.Wait(), then a single-threaded k-way merge and format.go write the sorted index." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1400" height="24" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;cmd/buildindex/main.go&lt;/b&gt; → &lt;b&gt;BuildIndex(paths)&lt;/b&gt;&lt;br&gt;each path → GzipFileSource{Path}&lt;br&gt;→ &lt;b&gt;Build(sources, out, logger)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="90" as="geometry"/></mxCell><mxCell id="l4" value="len(sources) ≥ 2 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="200" height="100" as="geometry"/></mxCell><mxCell id="l5" value="return error&lt;br&gt;main: os.Exit(1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="170" height="60" as="geometry"/></mxCell><mxCell id="l6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l8" value="&lt;b&gt;errgroup.Group · g.Go(func) once per Source → collectKeys(src)&lt;/b&gt;&lt;br&gt;each goroutine writes only sets[i] and lineCounts[i] → no shared state, no mutex (safe capture of i, src via Go 1.22 per-iteration loop vars)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="1000" height="60" as="geometry"/></mxCell><mxCell id="l9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l10" value="goroutine 0 · Source: couponbase1.gz" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="320" height="690" as="geometry"/></mxCell><mxCell id="l11" value="&lt;b&gt;src.Scan(onCode)&lt;/b&gt; · GzipFileSource&lt;br&gt;os.Open → gzip.NewReader (streaming)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="370" width="280" height="60" as="geometry"/></mxCell><mxCell id="l12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l8" target="l11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l13" value="&lt;b&gt;bufio.Scanner&lt;/b&gt;, each line held back until&lt;br&gt;the next reads cleanly; on read error the&lt;br&gt;cut-off last line is dropped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="450" width="280" height="60" as="geometry"/></mxCell><mxCell id="l14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l11" target="l13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l15" value="&lt;b&gt;ValidLength(line)?&lt;/b&gt;&lt;br&gt;8 ≤ len ≤ 10 bytes, else skip" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="530" width="280" height="60" as="geometry"/></mxCell><mxCell id="l16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;ht