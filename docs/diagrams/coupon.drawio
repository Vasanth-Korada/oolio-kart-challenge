gt;&lt;br&gt;two-pointer, in place, O(n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="850" width="280" height="60" as="geometry"/></mxCell><mxCell id="l24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l21" target="l23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l25" value="&lt;b&gt;sets[i] = keys&lt;/b&gt; · lineCounts[i] = lines&lt;br&gt;ErrPartialRead → Warn log, keep keys" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="930" width="280" height="60" as="geometry"/></mxCell><mxCell id="l26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l23" target="l25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l27" value="goroutine 1 · Source: couponbase2.gz" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="320" height="690" as="geometry"/></mxCell><mxCell id="l28" value="&lt;b&gt;src.Scan(onCode)&lt;/b&gt; · GzipFileSource&lt;br&gt;os.Open → gzip.NewReader (streaming)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="280" height="60" as="geometry"/></mxCell><mxCell id="l29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l8" target="l28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l30" value="&lt;b&gt;bufio.Scanner&lt;/b&gt;, each line held back until&lt;br&gt;the next reads cleanly; on read error the&lt;br&gt;cut-off last line is dropped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="450" width="280" height="60" as="geometry"/></mxCell><mxCell id="l31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l28" target="l30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l32" value="&lt;b&gt;ValidLength(line)?&lt;/b&gt;&lt;br&gt;8 ≤ len ≤ 10 bytes, else skip" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="530" width="280" height="60" as="geometry"/></mxCell><mxCell id="l33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l30" target="l32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l34" value="&lt;b&gt;makeKey(code)&lt;/b&gt; → codeKey [11]byte&lt;br&gt;k[0] = len(code) · k[1:] = code, zero-padded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="610" width="280" height="60" as="geometry"/></mxCell><mxCell id="l35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l32" target="l34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l36" value="&lt;b&gt;keys = append(keys, k)&lt;/b&gt;&lt;br&gt;~1.07e8 × 11 B ≈ 1.2 GB per file" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="280" height="60" as="geometry"/></mxCell><mxCell id="l37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l34" target="l36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l38" value="&lt;b&gt;slices.SortFunc&lt;/b&gt;(keys, compareKeys)&lt;br&gt;order: length byte, then code · O(n log n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="770" width="280" height="60" as="geometry"/></mxCell><mxCell id="l39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l36" target="l38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l40" value="&lt;b&gt;dedupeSorted&lt;/b&gt;&lt;br&gt;two-pointer, in place, O(n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="850" width="280" height="60" as="geometry"/></mxCell><mxCell id="l41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l38" target="l40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l42" value="&lt;b&gt;sets[i] = keys&lt;/b&gt; · lineCounts[i] = lines&lt;br&gt;ErrPartialRead → Warn log, keep keys" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="930" width="280" height="60" as="geometry"/></mxCell><mxCell id="l43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l40" target="l42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l44" value="goroutine 2 · Source: couponbase3.gz" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="320" height="690" as="geometry"/></mxCell><mxCell id="l45" value="&lt;b&gt;src.Scan(onCode)&lt;/b&gt; · GzipFileSource&lt;br&gt;os.Open → gzip.NewReader (streaming)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="280" height="60" as="geometry"/></mxCell><mxCell id="l46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l8" target="l45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l47" value="&lt;b&gt;bufio.Scanner&lt;/b&gt;, each line held back until&lt;br&gt;the next reads cleanly; on read error the&lt;br&gt;cut-off last line is dropped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="280" height="60" as="geometry"/></mxCell><mxCell id="l48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l45" target="l47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l49" value="&lt;b&gt;ValidLength(line)?&lt;/b&gt;&lt;br&gt;8 ≤ len ≤ 10 bytes, else skip" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="530" width="280" height="60" as="geometry"/></mxCell><mxCell id="l50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l47" target="l49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l51" value="&lt;b&gt;makeKey(code)&lt;/b&gt; → codeKey [11]byte&lt;br&gt;k[0] = len(code) · k[1:] = code, zero-padded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="280" height="60" as="geometry"/></mxCell><mxCell id="l52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l49" target="l51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l53" value="&lt;b&gt;keys = append(keys, k)&lt;/b&gt;&lt;br&gt;~1.07e8 × 11 B ≈ 1.2 GB per file" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="690" width="280" height="60" as="geometry"/></mxCell><mxCell id="l54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l51" target="l53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l55" value="&lt;b&gt;slices.SortFunc&lt;/b&gt;(keys, compareKeys)&lt;br&gt;order: length byte, then code · O(n log n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="770" width="280" height="60" as="geometry"/></mxCell><mxCell id="l56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l53" target="l55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l57" value="&lt;b&gt;dedupeSorted&lt;/b&gt;&lt;br&gt;two-pointer, in place, O(n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="280" height="60" as="geometry"/></mxCell><mxCell id="l58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l55" target="l57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l59" value="&lt;b&gt;sets[i] = keys&lt;/b&gt; · lineCounts[i] = lines&lt;br&gt;ErrPartialRead → Warn log, keep keys" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="930" width="280" height="60" as="geometry"/></mxCell><mxCell id="l60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l57" target="l59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l61" value="&lt;b&gt;Why dedupe per file?&lt;/b&gt;&lt;br&gt;The merge advances each list at most 1 step per round, so count ≤ 1 per file: that alone enforces “files, not lines”. Dedupe keeps output keys unique (X×2 in f1 and f2 would be emitted twice) and shrinks memory before merging." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="330" height="120" as="geometry"/></mxCell><mxCell id="l62" value="&lt;b&gt;Error handling&lt;/b&gt;&lt;br&gt;• open / gzip header error → hard error → g.Wait() fails the build&lt;br&gt;• truncated tail → Scan returns ErrPartialRead: Build logs Warn and keeps every complete line; the cut-off line is dropped (fix eb3a1b5; main indexed it)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="330" height="140" as="geometry"/></mxCell><mxCell id="l63" value="&lt;b&gt;Memory &amp;amp; concurrency&lt;/b&gt;&lt;br&gt;3 files in parallel ⇒ peak ≈ 3 × 1.2 GB + append growth slack (v1 hashes: 3 × 1.7 GB). Measured: no wall-clock win in the dev sandbox (I/O bound)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="630" width="330" height="105" as="geometry"/></mxCell><mxCell id="l64" value="&lt;b&gt;Why raw keys, not hashes?&lt;/b&gt;&lt;br&gt;Codes are ≤ 10 B, so they fit as-is: exact match, zero collision risk, 11 B vs 16 B, no SHA-256. Length byte keeps “ABCDEFGH” ≠ “ABCDEFGH\0” (tested). Trade-off: committed index holds plaintext codes." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="755" width="330" height="125" as="geometry"/></mxCell><mxCell id="l65" value="&lt;b&gt;Complexity&lt;/b&gt;&lt;br&gt;per file: O(n log n) time, 11 n bytes&lt;br&gt;merge: O(N · k), k = 3&lt;br&gt;lookup: O(log v), v = valid codes (8)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="900" width="330" height="105" as="geometry"/></mxCell><mxCell id="l66" value="&lt;b&gt;g.Wait()&lt;/b&gt;: barrier; first error aborts the build" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="1060" width="1000" height="50" as="geometry"/></mxCell><mxCell id="l67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l25" target="l66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l42" target="l66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l59" target="l66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l70" value="&lt;b&gt;mergeAtLeastN(sets, n = 2)&lt;/b&gt;&lt;br&gt;idxs := make([]int, k)  // one cursor per sorted list&lt;br&gt;loop {&lt;br&gt;&amp;nbsp;&amp;nbsp;min := smallest head among non-exhausted lists  // O(k)&lt;br&gt;&amp;nbsp;&amp;nbsp;if none left → break&lt;br&gt;&amp;nbsp;&amp;nbsp;count := #lists whose head == min; advance them&lt;br&gt;&amp;nbsp;&amp;nbsp;if count ≥ n → result = append(result, min)&lt;br&gt;}&lt;br&gt;⇒ result already ascending (merge order), no re-sort" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="200" y="1160" width="620" height="220" as="geometry"/></mxCell><mxCell id="l71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l66" target="l70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l72" value="&lt;b&gt;Worked example&lt;/b&gt; (build_test.go fixture)&lt;br&gt;f1 = [A, B, C]   f2 = [A, B]   f3 = [B]&lt;br&gt;&lt;br&gt;round 1: min=A, count=2 ✓ emit&lt;br&gt;round 2: min=B, count=3 ✓ emit&lt;br&gt;round 3: min=C, count=1 ✗ drop&lt;br&gt;done → result = [A, B]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="1160" width="340" height="220" as="geometry"/></mxCell><mxCell id="l73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;" edge="1" parent="1" source="l70" target="l72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l74" value="&lt;b&gt;writeIndexFile(out, valid)&lt;/b&gt;  build.go&lt;br&gt;os.MkdirAll(dir) → os.Create(out)&lt;br&gt;→ &lt;b&gt;writeIndex(io.Writer, keys)&lt;/b&gt;  format.go&lt;br&gt;guard: len(keys) ≤ math.MaxUint32&lt;br&gt;write 8-byte header (magic + count)&lt;br&gt;bufio.Writer: 11 B per key → Flush()&lt;br&gt;f.Close() error checked explicitly" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="200" y="1430" width="620" height="165" as="geometry"/></mxCell><mxCell id="l75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l70" target="l74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l76" value="&lt;b&gt;coupons.idx byte layout&lt;/b&gt; (big-endian, platform independent)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="1425" width="560" height="22" as="geometry"/></mxCell><mxCell id="l77" value="0-3&lt;br&gt;&lt;b&gt;&quot;CPX2&quot;&lt;/b&gt;&lt;br&gt;magic" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1455" width="90" height="70" as="geometry"/></mxCell><mxCell id="l78" value="4-7&lt;br&gt;&lt;b&gt;count&lt;/b&gt;&lt;br&gt;uint32 BE" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="1455" width="90" height="70" as="geometry"/></mxCell><mxCell id="l79" value="8-18&lt;br&gt;&lt;b&gt;key[0]&lt;/b&gt;&lt;br&gt;11 B" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="1455" width="100" height="70" as="geometry"/></mxCell><mxCell id="l80" value="19-29&lt;br&gt;&lt;b&gt;key[1]&lt;/b&gt;&lt;br&gt;11 B" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="1455" width="100" height="70" as="geometry"/></mxCell><mxCell id="l81" value="…" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1455" width="50" height="70" as="geometry"/></mxCell><mxCell id="l82" value="8+11(n−1)…&lt;br&gt;&lt;b&gt;key[n−1]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="1455" width="130" height="70" as="geometry"/></mxCell><mxCell id="l83" value="n = 8 valid codes ⇒ 8 + 8 × 11 = &lt;b&gt;96 bytes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="1535" width="560" height="22" as="geometry"/></mxCell><mxCell id="l84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="l74" target="l77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l85" value="&lt;b&gt;return Stats&lt;/b&gt;{PerFileLines, PerFileCandidates, TotalLines, ValidCodes = 8, IndexBytes = 96}&lt;br&gt;main logs “buildindex: complete” with elapsed time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="1630" width="620" height="70" as="geometry"/></mxCell><mxCell id="l86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l74" target="l85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l87" value="&lt;b&gt;Runtime consumer&lt;/b&gt; (cmd/server)&lt;br&gt;LoadIndex (format.go): ReadFile → parseIndex: magic, size == 8 + 11·count → &amp;amp;Index{keys}&lt;br&gt;Index.IsValid (index.go): ValidLength → makeKey → sort.Search → keys[i] == k" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1610" width="560" height="90" as="geometry"/></mxCell><mxCell id="l88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;" edge="1" parent="1" source="l82" target="l87"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - Dry run" id="d"><mxGraphModel dx="1580" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value="&lt;b&gt;BuildIndex: Dry Run&lt;/b&gt;  ·  13 input lines traced through every stage  ·  submission-v2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="d