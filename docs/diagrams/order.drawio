<mxfile host="app.diagrams.net"><diagram name="HLD - Order placement" id="oh"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="oh1" value="&lt;b&gt;Order Placement: High-Level Design&lt;/b&gt;  ·  POST /order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="oh2" value="Server-side pricing, coupon check, one DB transaction. Transport → Domain → Persistence, each layer behind an interface." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1400" height="24" as="geometry"/></mxCell><mxCell id="oh3" value="CLIENTS" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="210" height="790" as="geometry"/></mxCell><mxCell id="oh4" value="&lt;b&gt;React web app&lt;/b&gt;&lt;br&gt;oolio-kart-challenge-web&lt;br&gt;(cross-origin → CORS)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="80" as="geometry"/></mxCell><mxCell id="oh5" value="&lt;b&gt;Postman / newman&lt;/b&gt;&lt;br&gt;19 requests + assertions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="170" height="60" as="geometry"/></mxCell><mxCell id="oh6" value="&lt;b&gt;curl / any HTTP client&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="170" height="50" as="geometry"/></mxCell><mxCell id="oh7" value="cmd/server · single Go binary (distroless container, :8080)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="960" height="790" as="geometry"/></mxCell><mxCell id="oh8" value="TRANSPORT · internal/httpapi" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="920" height="300" as="geometry"/></mxCell><mxCell id="oh9" value="&lt;b&gt;http.Server&lt;/b&gt;&lt;br&gt;ReadHeader 5s · Read 10s&lt;br&gt;Write 10s · Idle 60s&lt;br&gt;SIGTERM → Shutdown(10s)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="175" width="200" height="100" as="geometry"/></mxCell><mxCell id="oh10" value="&lt;b&gt;Global middleware&lt;/b&gt; (outer → inner)&lt;br&gt;RequestID → Recover →&lt;br&gt;Logging → CORS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="175" width="260" height="100" as="geometry"/></mxCell><mxCell id="oh11" value="&lt;b&gt;http.ServeMux&lt;/b&gt; (Go 1.22 patterns)&lt;br&gt;GET /product · GET /product/{id}&lt;br&gt;POST /auth/token · POST /order&lt;br&gt;GET /healthz · GET /readyz · wrong method → 405" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="165" width="340" height="120" as="geometry"/></mxCell><mxCell id="oh12" value="&lt;b&gt;Authenticate → RequireScope&lt;/b&gt; (POST /order only)&lt;br&gt;Bearer JWT or api_key · none / bad token → 401&lt;br&gt;wrong key or no create_order scope → 403&lt;br&gt;(details: auth.drawio)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="340" height="80" as="geometry"/></mxCell><mxCell id="oh13" value="&lt;b&gt;OrderHandler.Create&lt;/b&gt;&lt;br&gt;JSON → order.CreateOrderRequest (bad → 400)&lt;br&gt;errors.Is → 422 / 500 · success → 200 JSON" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="360" height="90" as="geometry"/></mxCell><mxCell id="oh14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="oh4" target="oh9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="oh5" target="oh9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="oh6" target="oh9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh9" target="oh10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh10" target="oh11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh19" value="POST /order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh11" target="oh12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh20" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh12" target="oh13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh21" value="DOMAIN · internal/order, product, coupon" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="270" y="450" width="920" height="200" as="geometry"/></mxCell><mxCell id="oh22" value="&lt;b&gt;order.Service.PlaceOrder&lt;/b&gt;&lt;br&gt;validate → merge duplicate items&lt;br&gt;price from catalog (client prices never trusted)&lt;br&gt;coupon check → 5% discount → UUID v4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="360" height="130" as="geometry"/></mxCell><mxCell id="oh23" value="&lt;b&gt;product.Service.Get&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="340" height="50" as="geometry"/></mxCell><mxCell id="oh24" value="&lt;b&gt;coupon.Validator&lt;/b&gt; (interface)&lt;br&gt;Index: sorted []codeKey ([11]byte) in RAM · O(log n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="480" width="340" height="70" as="geometry"/></mxCell><mxCell id="oh25" value="PlaceOrder(ctx, req)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh13" target="oh22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh26" value="per item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh22" target="oh23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh27" value="IsValid(code)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh22" target="oh24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh28" value="PERSISTENCE · repositories" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="670" width="920" height="190" as="geometry"/></mxCell><mxCell id="oh29" value="&lt;b&gt;Chosen once at boot&lt;/b&gt;&lt;br&gt;Postgres reachable?&lt;br&gt;yes → DB repos&lt;br&gt;no → Memory repos + warn log (reviewer convenience)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="285" y="700" width="140" height="150" as="geometry"/></mxCell><mxCell id="oh30" value="&lt;b&gt;order.Repository&lt;/b&gt; (interface)&lt;br&gt;DBRepository: pgx tx → orders + order_items&lt;br&gt;MemoryRepository: mutex + map" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="360" height="110" as="geometry"/></mxCell><mxCell id="oh31" value="&lt;b&gt;product.Repository&lt;/b&gt; (interface)&lt;br&gt;DBRepository: SELECT … WHERE id = $1&lt;br&gt;MemoryRepository: seeded map" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="710" width="340" height="110" as="geometry"/></mxCell><mxCell id="oh32" value="Create(ctx, order)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh22" target="oh30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh33" value="GetByID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh23" target="oh31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh34" value="DATA" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1230" y="90" width="350" height="790" as="geometry"/></mxCell><mxCell id="oh35" value="&lt;b&gt;Key design points&lt;/b&gt;&lt;br&gt;• Prices come from the catalog, never the client&lt;br&gt;• unit_price snapshot per line: later price changes can't rewrite history&lt;br&gt;• One transaction: never an order without its items&lt;br&gt;• UUID v4 order ids (unguessable, IDOR-safe)&lt;br&gt;• Duplicate productIds merged before insert (PK order_id, product_id)&lt;br&gt;• Handler / Service / Repo split → fakes in tests, swap storage freely&lt;br&gt;• Validation errors → 422, malformed JSON → 400" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="310" height="240" as="geometry"/></mxCell><mxCell id="oh36" value="&lt;b&gt;coupons/coupons.idx&lt;/b&gt;&lt;br&gt;96 B (CPX2), loaded once at boot" style="shape=document;boundedLbl=1;size=0.2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="540" width="290" height="70" as="geometry"/></mxCell><mxCell id="oh37" value="&lt;b&gt;Postgres 16&lt;/b&gt; (pgxpool)&lt;br&gt;products · orders · order_items&lt;br&gt;schema_migrations (embedded SQL, run at boot)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="690" width="290" height="160" as="geometry"/></mxCell><mxCell id="oh38" value="loaded at boot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="oh24" target="oh36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh39" value="INSERT (tx)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="oh30" target="oh37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh40" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oh31" target="oh37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh41" value="&lt;b&gt;Status codes&lt;/b&gt;:  200 order created  ·  204 CORS preflight  ·  400 malformed JSON  ·  401 no or bad credentials  ·  403 wrong api_key or missing scope  ·  405 wrong method  ·  422 validation (empty, qty ≤ 0, unknown product, invalid coupon)  ·  500 unexpected (DB error, panic)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1550" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - Order placement flow" id="ol"><mxGraphModel dx="1700" dy="3250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ol82" value="RESPONSE · handler + middleware unwinding" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="2835" width="900" height="310" as="geometry"/></mxCell><mxCell id="ol75" value="REPOSITORY · order/db_repository.go (one transaction)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="2460" width="900" height="355" as="geometry"/></mxCell><mxCell id="ol68" value="SERVICE · order/service.go (business rules)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="340" y="1325" width="900" height="1115" as="geometry"/></mxCell><mxCell id="ol34" value="HANDLER · order_handler.go" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1055" width="900" height="250" as="geometry"/></mxCell><mxCell id="ol27" value="ROUTING · http.ServeMux + route middleware" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="655" width="900" height="380" as="geometry"/></mxCell><mxCell id="ol14" value="GLOBAL MIDDLEWARE · router.go + middleware.go (first in list = outermost)" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="900" height="545" as="geometry"/></mxCell><mxCell id="ol1" value="&lt;b&gt;Order Placement: Low-Level Design&lt;/b&gt;  ·  every branch of POST /order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="ol2" value="Main path runs top to bottom; red boxes are early exits with the exact status and error type the client sees." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1300" height="24" as="geometry"/></mxCell><mxCell id="ol3" value="&lt;b&gt;RequestID&lt;/b&gt;&lt;br&gt;id = header X-Request-Id, or idgen.NewUUID() if empty&lt;br&gt;set response header · ctx = withRequestID(ctx, id)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="460" height="70" as="geometry"/></mxCell><mxCell id="ol4" value="&lt;b&gt;Recover&lt;/b&gt;&lt;br&gt;defer: if recover() != nil → log “panic recovered” → 500 internal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol3" target="ol4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol6" value="&lt;b&gt;Logging&lt;/b&gt;&lt;br&gt;rec = statusRecorder{status: 200}; reqLogger = base.With(request_id)&lt;br&gt;ctx = withLogger · after next returns: log method, path, status, duration_ms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="460" height="75" as="geometry"/></mxCell><mxCell id="ol7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol4" target="ol6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol8" value="&lt;b&gt;CORS&lt;/b&gt;&lt;br&gt;Origin header present? → set Allow-Origin / Methods / Headers(Content-Type, Authorization, api_key)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="425" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol6" target="ol8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol10" value="method == OPTIONS ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="515" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol8" target="ol10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol12" value="&lt;b&gt;204 No Content&lt;/b&gt;&lt;br&gt;preflight ends here" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="525.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol10" target="ol12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol15" value="pattern “POST /order” matches ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="695" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol10" target="ol15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol17" value="&lt;b&gt;404&lt;/b&gt; unknown path&lt;br&gt;&lt;b&gt;405&lt;/b&gt; path ok, wrong method" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="705.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol15" target="ol17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol19" value="Authenticate ok ?&lt;br&gt;(Bearer JWT, else api_key)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="805" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol15" target="ol19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol21" value="&lt;b&gt;401&lt;/b&gt; no credentials or bad token&lt;br&gt;&lt;b&gt;403&lt;/b&gt; wrong api_key · see auth LLD" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="815.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol19" target="ol21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol23" value="RequireScope:&lt;br&gt;HasScope(“create_order”) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="915" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol19" target="ol23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol25" value="&lt;b&gt;403&lt;/b&gt; forbidden&lt;br&gt;“token lacks the create_order scope”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="925.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol23" target="ol25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol28" value="json.NewDecoder(body).Decode(&amp;amp;req) ok ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="1095" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol23" target="ol28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol30" value="&lt;b&gt;400&lt;/b&gt; invalid_body&lt;br&gt;“request body must be valid JSON”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1105.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol28" target="ol30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol32" value="map []orderItemRequest → []order.Item&lt;br&gt;created, err := Service.PlaceOrder(ctx, CreateOrderRequest{Items, CouponCode})" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1205" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol28" target="ol32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol35" value="len(req.Items) == 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="1365" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol32" target="ol35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol37" value="ErrEmptyItems → &lt;b&gt;422&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1375.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol35" target="ol37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol39" value="any raw quantity ≤ 0 or &amp;gt; 1000 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="1475" width="320" height="90" as="geometry"/></mxCell><mxCell id="ol40" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol35" target="ol39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol41" value="ErrInvalidQuantity / ErrQuantityTooLarge&lt;br&gt;→ &lt;b&gt;422&lt;/b&gt; (bounded before merging,&lt;br&gt;so the sum can't overflow int)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1490.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol42" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol39" target="ol41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol43" value="&lt;b&gt;mergeItems&lt;/b&gt;: quantityByID map[string]int + first-seen order []string&lt;br&gt;[{1,2},{3,1},{1,1}] → [{1,3},{3,1}]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1595" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol44" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol39" target="ol43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol45" value="any merged quantity &amp;gt; 1000 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="1685" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol43" target="ol45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol47" value="ErrQuantityTooLarge → &lt;b&gt;422&lt;/b&gt;&lt;br&gt;(e.g. 600 + 600 of one product)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1695.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol48" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol45" target="ol47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol49" value="&lt;b&gt;for each merged item&lt;/b&gt;: p, err := products.Get(ctx, id)&lt;br&gt;→ repo.GetByID → 1 SQL query per item (N+1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1795" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol50" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol45" target="ol49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol51" value="err != nil ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="1885" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol49" target="ol51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol53" value="ErrNotFound → ErrProductNotFound → &lt;b&gt;422&lt;/b&gt;&lt;br&gt;other error → returned as-is → &lt;b&gt;500&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1895.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol54" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol51" target="ol53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol55" value="resolved = append(resolved, p)&lt;br&gt;subtotal += p.Price × float64(qty)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1995" width="460" height="55" as="geometry"/></mxCell><mxCell id="ol56" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol51" target="ol55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol57" value="more items ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="2080" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol55" target="ol57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol61" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol57" target="ol49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol62" value="couponCode != “” AND !coupons.IsValid(code) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="2190" width="320" height="90" as="geometry"/></mxCell><mxCell id="ol63" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol57" target="ol62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol64" value="ErrInvalidCoupon → &lt;b&gt;422&lt;/b&gt;&lt;br&gt;(warn log with coupon_code)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="2205.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol65" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol62" target="ol64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol66" value="discount = coupon ? roundMoney(subtotal × 0.05) : 0&lt;br&gt;subtotal = roundMoney(subtotal)&lt;br&gt;Order{ID: idgen.NewUUID() (v4), Items: merged, Products: resolved,&lt;br&gt;&amp;nbsp;&amp;nbsp;Subtotal, Discount, Total: roundMoney(subtotal − discount)}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="2310" width="460" height="90" as="geometry"/></mxCell><mxCell id="ol67" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol62" target="ol66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol69" value="&lt;b&gt;pgx.BeginFunc(ctx, pool, fn)&lt;/b&gt;&lt;br&gt;INSERT INTO orders (id, coupon_code, subtotal, discount, total)&lt;br&gt;&amp;nbsp;&amp;nbsp;coupon_code = NULL when empty&lt;br&gt;priceByProductID := map from o.Products&lt;br&gt;for each item: INSERT INTO order_items (order_id, product_id, quantity, unit_price)&lt;br&gt;fn returns nil → COMMIT · any error → ROLLBACK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="2500" width="460" height="165" as="geometry"/></mxCell><mxCell id="ol70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol66" target="ol69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol71" value="tx error ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450.0" y="2695" width="320" height="80" as="geometry"/></mxCell><mxCell id="ol72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol69" target="ol71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol73" value="&lt;b&gt;500&lt;/b&gt; internal “failed to place order”&lt;br&gt;e.g. database unreachable mid-request" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="2705.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="ol74" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol71" target="ol73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol76" value="service: s.logger.InfoContext(“order: created”, order_id, item_count, discount)&lt;br&gt;(no request_id: service logger isn't request-scoped) → return created" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="2875" width="460" height="55" as="geometry"/></mxCell><mxCell id="ol77" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol71" target="ol76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol78" value="&lt;b&gt;200&lt;/b&gt; WriteJSON(toOrderResponse(created))&lt;br&gt;{id, items, products, couponCode, subtotal, discounts, total}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="2960" width="460" height="60" as="geometry"/></mxCell><mxCell id="ol79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol76" target="ol78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol80" value="middleware unwinds: Logging writes access log&lt;br&gt;{request_id, method, path, status 200, duration_ms}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="3050" width="460" height="55" as="geometry"/></mxCell><mxCell id="ol81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ol78" target="ol80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol83" value="&lt;b&gt;Middleware order subtlety&lt;/b&gt;&lt;br&gt;chain(mux, RequestID, Recover, Logging, CORS) wraps in reverse, so RequestID is outermost.&lt;br&gt;&lt;br&gt;A panic in the handler unwinds &lt;i&gt;past&lt;/i&gt; Logging → that request gets &lt;b&gt;no access log&lt;/b&gt;. Recover then reads the logger from a ctx Logging never touched → panic log has &lt;b&gt;no request_id&lt;/b&gt;. Fix: put Logging outside Recover." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="90" width="400" height="230" as="geometry"/></mxCell><mxCell id="ol84" value="&lt;b&gt;Error contract&lt;/b&gt;&lt;br&gt;Every error body: {code, type, message}&lt;br&gt;400 only for malformed JSON; all business-rule failures → 422 validation_error; unknown errors → 500 without leaking internals (details go to logs)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="340" width="400" height="150" as="geometry"/></mxCell><mxCell id="ol85" value="&lt;b&gt;Why merge duplicate items?&lt;/b&gt;&lt;br&gt;order_items PK is (order_id, product_id). Two rows for the same product would violate it → 500. Summing quantities is also the sensible reading of “same product twice in a cart”." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="510" width="400" height="150" as="geometry"/></mxCell><mxCell id="ol86" value="&lt;b&gt;Transaction semantics&lt;/b&gt;&lt;br&gt;BeginFunc commits only if fn returns nil; any INSERT error rolls back everything. There's never an order row without its items." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="680" width="400" height="120" as="geometry"/></mxCell><mxCell id="ol87" value="&lt;b&gt;Known limitations (planned improvements)&lt;/b&gt;&lt;br&gt;• N+1: one SELECT per item, one INSERT per item → WHERE id = ANY($1), pgx.Batch / CopyFrom&lt;br&gt;• float64 money → int64 cents or decimal&lt;br&gt;• Coupon checked AFTER the DB lookups → check it first (cheap, in-memory)&lt;br&gt;• No body size limit (http.MaxBytesReader)&lt;br&gt;• No Idempotency-Key → client retry = duplicate order&lt;br&gt;• Service logs lack request_id (s.logger isn't request-scoped; verified)&lt;br&gt;• “01” works on GET /product/01 but not as an order productId" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="820" width="400" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Dry run - real request" id="od"><mxGraphModel dx="1620" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="od1" value="&lt;b&gt;Order Placement: Dry Run&lt;/b&gt;  ·  captured from the real stack (docker compose: Go server + Postgres 16)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="od2" value="Every value below (response, ids, DB rows, log lines, status codes) was captured from actual requests, not hand-computed. Captured on main; re-run on submission-v2 gives identical totals, and the quantity row was re-captured after the cap." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1400" height="24" as="geometry"/></mxCell><mxCell id="od3" value="&lt;b&gt;REQUEST&lt;/b&gt;&lt;br&gt;POST /order HTTP/1.1&lt;br&gt;Content-Type: application/json&lt;br&gt;api_key: apitest&lt;br&gt;X-Request-Id: dryrun-001&lt;br&gt;&lt;br&gt;{&quot;couponCode&quot;: &quot;HAPPYHRS&quot;,&lt;br&gt;&amp;nbsp;&quot;items&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;productId&quot;: &quot;1&quot;, &quot;quantity&quot;: 2},&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;productId&quot;: &quot;3&quot;, &quot;quantity&quot;: 1},&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;productId&quot;: &quot;1&quot;, &quot;quantity&quot;: 1}]}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="440" height="190" as="geometry"/></mxCell><mxCell id="od4" value="&lt;b&gt;1 · RequestID&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="170" height="55" as="geometry"/></mxCell><mxCell id="od5" value="X-Request-Id “dryrun-001” supplied → reused (not generated)&lt;br&gt;echoed back as response header X-Request-Id: dryrun-001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="320" width="760" height="55" as="geometry"/></mxCell><mxCell id="od6" value="&lt;b&gt;2 · Logging&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="387" width="170" height="40" as="geometry"/></mxCell><mxCell id="od7" value="reqLogger = base.With(request_id=&quot;dryrun-001&quot;) stored in ctx" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="387" width="760" height="40" as="geometry"/></mxCell><mxCell id="od8" value="&lt;b&gt;3 · CORS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="439" width="170" height="40" as="geometry"/></mxCell><mxCell id="od9" value="no Origin header (curl) → no Access-Control headers · method POST → continue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="439" width="760" height="40" as="geometry"/></mxCell><mxCell id="od10" value="&lt;b&gt;4 · ServeMux&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="491" width="170" height="40" as="geometry"/></mxCell><mxCell id="od11" value="“POST /order” matched → Authenticate → RequireScope → OrderHandler.Create" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="491" width="760" height="40" as="geometry"/></mxCell><mxCell id="od12" value="&lt;b&gt;5 · Authenticate&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="543" width="170" height="40" as="geometry"/></mxCell><mxCell id="od13" value="no Authorization header → api_key “apitest” = API_KEY (ConstantTimeCompare) ✓&lt;br&gt;claims {sub: api_key, scopes: [create_order]} → RequireScope ✓" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="543" width="760" height="40" as="geometry"/></mxCell><mxCell id="od14" value="&lt;b&gt;6 · Decode&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="170" height="55" as="geometry"/></mxCell><mxCell id="od15" value="placeOrderRequest{CouponCode: &quot;HAPPYHRS&quot;,&lt;br&gt;&amp;nbsp;Items: [{1 2} {3 1} {1 1}]}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="595" width="760" height="55" as="geometry"/></mxCell><mxCell id="od16" value="&lt;b&gt;7 · Validate&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="170" height="40" as="geometry"/></mxCell><mxCell id="od17" value="len(items) = 3 ≠ 0 ✓ · quantities 2, 1, 1 all within 1..1000 ✓" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="662" width="760" height="40" as="geometry"/></mxCell><mxCell id="od18" value="&lt;b&gt;8 · mergeItems&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="170" height="55" as="geometry"/></mxCell><mxCell id="od19" value="quantityByID = {&quot;1&quot;: 3, &quot;3&quot;: 1} · order = [&quot;1&quot;, &quot;3&quot;]&lt;br&gt;→ [{1 3} {3 1}]  (3 lines → 2 line items) · merged 3, 1 ≤ 1000 ✓" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="714" width="760" height="55" as="geometry"/></mxCell><mxCell id="od20" value="&lt;b&gt;9 · Price lookup&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="781" width="170" height="125" as="geometry"/></mxCell><mxCell id="od21" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px;font-family:Courier New'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;productId&lt;/th&gt;&lt;th&gt;SELECT … WHERE id=$1&lt;/th&gt;&lt;th&gt;price&lt;/th&gt;&lt;th&gt;qty&lt;/th&gt;&lt;th&gt;line total&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Waffle with Berries&lt;/td&gt;&lt;td&gt;6.50&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;19.50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Macaron Mix of Five&lt;/td&gt;&lt;td&gt;8.00&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;8.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;subtotal&lt;/td&gt;&lt;td&gt;&lt;b&gt;27.50&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="781" width="760" height="125" as="geometry"/></mxCell><mxCell id="od22" value="&lt;b&gt;10 · Coupon&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="170" height="40" as="geometry"/></mxCell><mxCell id="od23" value="“HAPPYHRS”: len 8 ✓ → makeKey → [08|HAPPYHRS∅∅] → sort.Search on 8 keys → found ✓" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="918" width="760" height="40" as="geometry"/></mxCell><mxCell id="od24" value="&lt;b&gt;11 · Money&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="170" height="70" as="geometry"/></mxCell><mxCell id="od25" value="discount = roundMoney(27.50 × 0.05) = math.Round(137.5) / 100 = &lt;b&gt;1.38&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1.375 → half rounds away from zero)&lt;br&gt;total = roundMoney(27.50 − 1.38) = &lt;b&gt;26.12&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="970" width="760" height="70" as="geometry"/></mxCell><mxCell id="od26" value="&lt;b&gt;12 · Order ID&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1052" width="170" height="55" as="geometry"/></mxCell><mxCell id="od27" value="idgen.NewUUID() → 5cb5a242-7973-&lt;b&gt;4&lt;/b&gt;830-&lt;b&gt;b&lt;/b&gt;2b1-57f847d358b3&lt;br&gt;version nibble 4 · variant bits 10xx (b) · 122 random bits" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="1052" width="760" height="55" as="geometry"/></mxCell><mxCell id="od28" value="&lt;b&gt;13 · Transaction&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1119" width="170" height="115" as="geometry"/></mxCell><mxCell id="od29" value="BEGIN&lt;br&gt;INSERT INTO orders (id, coupon_code, subtotal, discount, total)&lt;br&gt;&amp;nbsp;&amp;nbsp;VALUES ('5cb5a242-…', 'HAPPYHRS', 27.5, 1.38, 26.12)&lt;br&gt;INSERT INTO order_items VALUES ('5cb5a242-…', '1', 3, 6.5)&lt;br&gt;INSERT INTO order_items VALUES ('5cb5a242-…', '3', 1, 8)&lt;br&gt;COMMIT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="1119" width="760" height="115" as="geometry"/></mxCell><mxCell id="od30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="od3" target="od4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od31" value="&lt;b&gt;DB ROWS AFTER COMMIT&lt;/b&gt; (psql)&lt;br&gt;&lt;br&gt;orders&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px;font-family:Courier New'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;id&lt;/th&gt;&lt;th&gt;coupon_code&lt;/th&gt;&lt;th&gt;subtotal&lt;/th&gt;&lt;th&gt;discount&lt;/th&gt;&lt;th&gt;total&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5cb5a242-…&lt;/td&gt;&lt;td&gt;HAPPYHRS&lt;/td&gt;&lt;td&gt;27.50&lt;/td&gt;&lt;td&gt;1.38&lt;/td&gt;&lt;td&gt;26.12&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;order_items&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px;font-family:Courier New'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;order_id&lt;/th&gt;&lt;th&gt;product_id&lt;/th&gt;&lt;th&gt;quantity&lt;/th&gt;&lt;th&gt;unit_price&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5cb5a242-…&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;6.50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5cb5a242-…&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;8.00&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;NUMERIC(10,2) columns store exact decimals; Go reads/writes float64." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="560" height="280" as="geometry"/></mxCell><mxCell id="od32" value="&lt;b&gt;RESPONSE&lt;/b&gt;  200 OK · X-Request-Id: dryrun-001&lt;br&gt;&lt;br&gt;{&quot;id&quot;: &quot;5cb5a242-7973-4830-b2b1-57f847d358b3&quot;,&lt;br&gt;&amp;nbsp;&quot;items&quot;: [{&quot;productId&quot;:&quot;1&quot;,&quot;quantity&quot;:3},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&quot;productId&quot;:&quot;3&quot;,&quot;quantity&quot;:1}],&lt;br&gt;&amp;nbsp;&quot;products&quot;: [{&quot;id&quot;:&quot;1&quot;,&quot;name&quot;:&quot;Waffle with Berries&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;price&quot;:6.5, …image…}, {&quot;id&quot;:&quot;3&quot;, …}],&lt;br&gt;&amp;nbsp;&quot;couponCode&quot;: &quot;HAPPYHRS&quot;,&lt;br&gt;&amp;nbsp;&quot;subtotal&quot;: 27.5,&lt;br&gt;&amp;nbsp;&quot;discounts&quot;: 1.38,&lt;br&gt;&amp;nbsp;&quot;total&quot;: 26.12}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="560" height="230" as="geometry"/></mxCell><mxCell id="od33" value="&lt;b&gt;LOG LINES&lt;/b&gt; (JSON, stdout)&lt;br&gt;&lt;br&gt;{&quot;level&quot;:&quot;INFO&quot;,&quot;msg&quot;:&quot;order: created&quot;,&lt;br&gt;&amp;nbsp;&quot;order_id&quot;:&quot;5cb5a242-…&quot;,&quot;item_count&quot;:2,&quot;discount&quot;:1.38}&lt;br&gt;&amp;nbsp;&amp;nbsp;← &lt;b&gt;no request_id&lt;/b&gt; (service logger isn't request-scoped)&lt;br&gt;&lt;br&gt;{&quot;level&quot;:&quot;INFO&quot;,&quot;msg&quot;:&quot;http request&quot;,&quot;request_id&quot;:&quot;dryrun-001&quot;,&lt;br&gt;&amp;nbsp;&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/order&quot;,&quot;status&quot;:200,&quot;duration_ms&quot;:20.557}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="670" width="560" height="160" as="geometry"/></mxCell><mxCell id="od34" value="&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;Left: the request's state after each layer, top to bottom. Right: what came out: rows persisted, the response body, and the log lines. Note the response items are the &lt;i&gt;merged&lt;/i&gt; lines (qty 3 for product 1), not what the client sent." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1020" y="860" width="560" height="90" as="geometry"/></mxCell><mxCell id="od35" value="&lt;b&gt;Error paths&lt;/b&gt;: same stack, one request each (actual status + body)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="1276" width="1200" height="24" as="geometry"/></mxCell><mxCell id="od36" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px;font-family:Courier New'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;request (all POST /order unless noted)&lt;/th&gt;&lt;th&gt;status&lt;/th&gt;&lt;th&gt;response body / note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;no credentials&lt;/td&gt;&lt;td&gt;401&lt;/td&gt;&lt;td&gt;{&quot;type&quot;:&quot;unauthorized&quot;,&quot;message&quot;:&quot;missing credentials: send an Authorization Bearer token or the api_key header&quot;}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;api_key: nope&lt;/td&gt;&lt;td&gt;403&lt;/td&gt;&lt;td&gt;{&quot;type&quot;:&quot;forbidden&quot;,&quot;message&quot;:&quot;invalid api_key&quot;}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;body: {&quot;items&quot;:[&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;td&gt;{&quot;type&quot;:&quot;invalid_body&quot;,&quot;message&quot;:&quot;request body must be valid JSON&quot;}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{&quot;items&quot;:[]}&lt;/td&gt;&lt;td&gt;422&lt;/td&gt;&lt;td&gt;order must contain at least one item&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{&quot;items&quot;:[{&quot;productId&quot;:&quot;1&quot;,&quot;quantity&quot;:0}]}&lt;/td&gt;&lt;td&gt;422&lt;/td&gt;&lt;td&gt;item quantity must be greater than zero: product 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{&quot;items&quot;:[{&quot;productId&quot;:&quot;99&quot;,&quot;quantity&quot;:1}]}&lt;/td&gt;&lt;td&gt;422&lt;/td&gt;&lt;td&gt;one or more products were not found: product 99&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;couponCode &quot;SUPER100&quot; + 1 item&lt;/td&gt;&lt;td&gt;422&lt;/td&gt;&lt;td&gt;coupon code is invalid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;{&quot;items&quot;:[{&quot;productId&quot;:&quot;10&quot;,&quot;quantity&quot;:20000000}]}&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style='color:#2e7d32'&gt;422&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;item quantity must be at most 1000: product 10&lt;/b&gt; (was 500)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;OPTIONS /order + Origin header&lt;/td&gt;&lt;td&gt;204&lt;/td&gt;&lt;td&gt;Allow-Origin *, Allow-Methods GET, POST, OPTIONS, Allow-Headers Content-Type, Authorization, api_key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GET /order&lt;/td&gt;&lt;td&gt;405&lt;/td&gt;&lt;td&gt;Method Not Allowed (ServeMux, plain text, not the JSON error shape)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="1306" width="1100" height="360" as="geometry"/></mxCell><mxCell id="od37" value="&lt;b&gt;✓ Found by this dry run, now fixed&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Before:&lt;/b&gt; 20,000,000 × 9.00 = 180,000,000.00 &amp;gt; NUMERIC(10,2) max 99,999,999.99 → Postgres rejected the INSERT → &lt;b&gt;500&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Now:&lt;/b&gt; each line item is capped at 1000 (MaxItemQuantity), checked on the raw items and again after merging → ErrQuantityTooLarge → &lt;b&gt;422&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Raw items are bounded before merging, so two huge duplicates can't overflow int into a negative quantity." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1160" y="1306" width="420" height="305" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>