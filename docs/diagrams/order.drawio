<mxfile host="app.diagrams.net"><diagram name="HLD - Order placement" id="oh"><mxGraphModel dx="1520" dy="580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="oh1" value="&lt;b&gt;Order placement&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="oh2" value="POST /order: price on the server, check the coupon, save in one transaction." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="oh3" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;web app · Postman · curl&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="180" height="64" as="geometry"/></mxCell><mxCell id="oh4" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;request id · metrics · logs · CORS&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="230" height="64" as="geometry"/></mxCell><mxCell id="oh5" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Bearer JWT or api_key&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="190" height="64" as="geometry"/></mxCell><mxCell id="oh6" value="&lt;b&gt;Order handler&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;JSON in, JSON out&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="130" width="190" height="64" as="geometry"/></mxCell><mxCell id="oh7" value="&lt;b&gt;Order service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;validate · merge · price&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="210" height="64" as="geometry"/></mxCell><mxCell id="oh8" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh3" target="oh4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh4" target="oh5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh5" target="oh6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh6" target="oh7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh12" value="&lt;b&gt;Products&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1 query for the cart&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="oh13" value="&lt;b&gt;Order repository&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1 transaction&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="oh14" value="&lt;b&gt;Coupons&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;in-memory index&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="oh15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh7" target="oh12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="oh7" target="oh13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="oh7" target="oh14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh18" value="&lt;b&gt;Postgres&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="935" y="450" width="200" height="80" as="geometry"/></mxCell><mxCell id="oh19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="oh12" target="oh18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="oh13" target="oh18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oh21" value="&lt;b&gt;Key points&lt;/b&gt;&lt;br&gt;• Prices come from the catalog, never the client&lt;br&gt;• 5 SQL statements per order, any cart size&lt;br&gt;• At most 100 lines; a bad coupon never reaches the DB&lt;br&gt;• Errors: 400 · 401 · 403 · 422 · 500" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="420" height="136" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LLD - Order placement flow" id="ol"><mxGraphModel dx="1320" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ol1" value="&lt;b&gt;Order placement: step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="ol2" value="Top to bottom; red boxes are the errors a client can get." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="ol3" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;request id · metrics · logs · CORS&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol4" value="Credentials valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="205" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol3" target="ol4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol6" value="401 missing or bad token&lt;br&gt;403 wrong api_key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol4" target="ol6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol8" value="Allowed to order?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="325" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol4" target="ol8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol10" value="403 missing scope" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="345" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol8" target="ol10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol12" value="Valid JSON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol8" target="ol12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol14" value="400 bad JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="465" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol12" target="ol14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol16" value="Items OK?&lt;br&gt;&lt;span style='font-size:11px'&gt;1 to 100 lines · qty 1 to 1000&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="565" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol12" target="ol16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol18" value="422 invalid items&lt;br&gt;or more than 100 lines" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="585" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol16" target="ol18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol20" value="&lt;b&gt;Merge duplicates&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;same product → one line&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="685" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol16" target="ol20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol22" value="Coupon valid?&lt;br&gt;&lt;span style='font-size:11px'&gt;in memory, if one was sent&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="780" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol20" target="ol22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol24" value="422 invalid coupon&lt;br&gt;(no SQL sent)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol22" target="ol24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol26" value="&lt;b&gt;Look up products&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1 query for the whole cart&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol22" target="ol26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol28" value="All products exist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="995" width="220" height="86" as="geometry"/></mxCell><mxCell id="ol29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol26" target="ol28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol30" value="422 lists every&lt;br&gt;unknown product" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="1015" width="190" height="46" as="geometry"/></mxCell><mxCell id="ol31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ol28" target="ol30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol32" value="&lt;b&gt;Price the order&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;subtotal · discount rule · total&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="1115" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol28" target="ol32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol34" value="&lt;b&gt;Save&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1 transaction: order + all lines&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="1210" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol32" target="ol34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol36" value="&lt;b&gt;200 OK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;order JSON&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="1305" width="200" height="60" as="geometry"/></mxCell><mxCell id="ol37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="ol34" target="ol36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ol38" value="&lt;b&gt;Why it is fast&lt;/b&gt;&lt;br&gt;• Cheap checks first: line cap, then the in-memory coupon, then SQL&lt;br&gt;• 1 query reads every product&lt;br&gt;• 1 insert writes every line&lt;br&gt;• 5 statements for any cart size (was 23 for 10 products)&lt;br&gt;• A bad coupon costs 0 statements (was 1)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="380" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Dry run - real request" id="od"><mxGraphModel dx="900" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="od1" value="&lt;b&gt;Order placement: dry run&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="32" as="geometry"/></mxCell><mxCell id="od2" value="A real request on Docker + Postgres, with the values it produced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="od3" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HAPPYHRS · product 1 × 2, 3 × 1, 1 × 1&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="330" height="64" as="geometry"/></mxCell><mxCell id="od4" value="&lt;b&gt;1 · Merge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;3 lines (≤ 100) → product 1 × 3, product 3 × 1&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="330" height="60" as="geometry"/></mxCell><mxCell id="od5" value="&lt;b&gt;2 · Coupon&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;HAPPYHRS valid (in memory, before any SQL)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="298" width="330" height="60" as="geometry"/></mxCell><mxCell id="od6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="od4" target="od5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od7" value="&lt;b&gt;3 · Prices&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;6.50 × 3 + 8.00 × 1 = 27.50&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="386" width="330" height="60" as="geometry"/></mxCell><mxCell id="od8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="od5" target="od7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od9" value="&lt;b&gt;4 · Total&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;5% = 1.38 · 27.50 − 1.38 = 26.12&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="330" height="60" as="geometry"/></mxCell><mxCell id="od10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="od7" target="od9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od11" value="&lt;b&gt;5 · Save&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BEGIN · order · 2 lines in 1 insert · COMMIT&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="562" width="330" height="60" as="geometry"/></mxCell><mxCell id="od12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="od9" target="od11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od13" value="&lt;b&gt;6 · Response&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;200 · id 5cb5a242-…&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="330" height="60" as="geometry"/></mxCell><mxCell id="od14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="od11" target="od13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="od15" value="&lt;b&gt;Error responses&lt;/b&gt; (same stack)&lt;br&gt;&lt;br&gt;&lt;table cellpadding='5' style='font-size:13px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;400&lt;/b&gt;&lt;/td&gt;&lt;td&gt;body is not valid JSON&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;401&lt;/b&gt;&lt;/td&gt;&lt;td&gt;no credentials or bad token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;403&lt;/b&gt;&lt;/td&gt;&lt;td&gt;wrong api_key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;422&lt;/b&gt;&lt;/td&gt;&lt;td&gt;over 100 lines · qty over 1000 · bad coupon · unknown product&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;405&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /order&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="420" height="250" as="geometry"/></mxCell><mxCell id="od16" value="&lt;b&gt;SQL per order&lt;/b&gt;&lt;br&gt;• 5 statements, for any cart size&lt;br&gt;• 10 products: 23 → 5&lt;br&gt;• p50 5.7 → 2.3 ms (10-product orders)&lt;br&gt;• bad coupon: 1 → 0 statements (rejected before SQL)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="420" height="136" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>